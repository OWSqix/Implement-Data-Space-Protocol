.omx/
.omc/

# Source PDFs dropped at the repository root (planning reports, scanned
# originals). These run to ~100 MB and approach the GitHub 100 MiB blob
# limit, so a single `git add -A` would stage one. Blocked structurally
# instead of relying on a manual `git reset -- '*.pdf'` before each commit.
# Root-scoped on purpose: PDFs inside molit-dataspace/ (e.g. evidence
# attachments) stay trackable. No PDF has ever been committed to this repo.
/*.pdf

docs/*
!docs/reference/
!docs/reference/**

# Tooling state that must not pollute the tracked reference tree.
docs/reference/.omc/

# Cloned upstream reference repositories — local-only working copies.
# Kept with their own .git so they can be updated via `git pull`; never
# committed to this repo (re-ignored after the docs/reference un-ignore above).
docs/reference/eclipse-edc/
docs/reference/dataspace-protocol/
docs/reference/tck/
docs/reference/eclipse-tractusx/
docs/reference/gaia-x/
