{
  "schemaVersion": "molit.dsaas-runtime-config/1",
  "environment": "production",
  "listenHost": "0.0.0.0",
  "port": 8888,
  "identityConfigPath": "../../deploy/identity/dsaas.identity.production.example.json",
  "observabilityConfigPath": "../../deploy/observability/dsaas.production.example.json",
  "tls": {
    "certFile": "/var/run/secrets/molit-inbound/tls.crt",
    "keyFile": "/var/run/secrets/molit-inbound/tls.key",
    "clientCaFile": "/var/run/secrets/molit-inbound/client-ca.crt",
    "reloadIntervalMs": 5000
  },
  "publicOrigin": "https://dsaas.data.molit.go.kr",
  "allowedHosts": [
    "dsaas.data.molit.go.kr"
  ],
  "stateStore": {
    "type": "postgres",
    "connectionStringEnv": "MOLIT_DSAAS_POSTGRES_URL",
    "holderIdEnv": "MOLIT_DSAAS_INSTANCE_ID",
    "applicationName": "molit-dsaas-control-plane",
    "tls": {
      "mode": "verify-full",
      "caEnv": "MOLIT_DSAAS_POSTGRES_CA_PEM"
    },
    "maxPoolSize": 20,
    "maxLeasePoolSize": 20,
    "connectionTimeoutMs": 5000,
    "idleTimeoutMs": 30000,
    "statementTimeoutMs": 30000,
    "lockTimeoutMs": 5000
  },
  "serviceRegistryPath": "service-registry.example.json",
  "serviceRegistrySha256": "e870ff554385dac39244caf01ac284762996209e6868a2fbfc4a85957fcd4107",
  "serviceRegistryMaxAgeSeconds": 86400,
  "approvalDecisionRegistryPath": "approval-decision-registry.example.json",
  "approvalDecisionRegistrySha256": "d75d10c2b6f004a75a2d25b2dd8d9fe2ba159b34cedc7cad57b9441af5814ebf",
  "approvalDecisionRegistryMaxAgeSeconds": 86400,
  "approvedMetadataProfiles": [
    {
      "iri": "https://data.molit.go.kr/profile/molit-dcat-ap/1.0.0-rc.1",
      "version": "1.0.0-rc.1",
      "sha256": "0666b7c2ed74800264a9ac6c8292f819fc973a02057397faca3b3d5df3bacfe4"
    }
  ],
  "approvedGovernanceBundles": [
    {
      "iri": "https://data.molit.go.kr/governance/molit-dataspace/0.1.0",
      "version": "0.1.0",
      "sha256": "bb223e8313e044f4d70c7406d8ea4bebc59929689ff39f60319a9bfab9004ed1"
    }
  ],
  "connectorPlanIds": [
    "edc-isolated"
  ],
  "allowedNamespaceOrigins": [
    "https://data.molit.go.kr"
  ],
  "caas": {
    "baseUrl": "https://caas.data.molit.go.kr/",
    "ensurePath": "/v1/connectors/ensure",
    "supportsIdempotencyKey": true,
    "auth": {
      "type": "oauth2-client-credentials-mtls",
      "tokenUrl": "https://identity.data.molit.go.kr/oauth2/token",
      "clientId": "molit-dsaas-controller",
      "clientSecretRef": "file:///var/run/secrets/molit-caas-client/client-secret",
      "scope": "caas.controller",
      "refreshSkewSeconds": 60,
      "caFile": "/var/run/secrets/molit-caas-client/ca.crt",
      "certFile": "/var/run/secrets/molit-caas-client/tls.crt",
      "keyFile": "/var/run/secrets/molit-caas-client/tls.key",
      "serverName": "caas.data.molit.go.kr"
    }
  },
  "reconcileScheduler": {
    "intervalMs": 60000,
    "maxDataspacesPerTick": 100,
    "readinessMaxLagMs": 180000,
    "caasRetryBaseMs": 60000,
    "caasRetryMaxMs": 3600000
  },
  "network": {
    "allowedOrigins": [
      "https://caas.data.molit.go.kr",
      "https://identity.data.molit.go.kr"
    ],
    "privateOrigins": [
      "https://caas.data.molit.go.kr",
      "https://identity.data.molit.go.kr"
    ],
    "allowHttp": false,
    "allowPrivate": false,
    "timeoutMs": 15000,
    "maxResponseBytes": 1048576,
    "retries": 2
  },
  "limits": {
    "maxRequestBytes": 262144,
    "maxStateBytes": 67108864,
    "maxDataspaces": 100,
    "maxParticipantsPerDataspace": 10000,
    "maxIdempotencyRecords": 100000,
    "maxReconcileSupersessions": 8,
    "headerTimeoutMs": 15000,
    "requestTimeoutMs": 30000,
    "keepAliveTimeoutMs": 5000,
    "gracefulShutdownMs": 30000
  }
}
