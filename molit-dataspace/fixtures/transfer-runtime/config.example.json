{
  "schemaVersion": "molit.provider-transfer-runtime-config/1",
  "environment": "production",
  "journalPath": "../../.local/provider-transfer-journal.json",
  "journalIntegrity": {
    "keyEnv": "MOLIT_TRANSFER_JOURNAL_HMAC_KEY",
    "keyId": "molit-transfer-journal-2026-01"
  },
  "network": {
    "allowedOrigins": [
      "https://connector.internal.example",
      "https://export.internal.example"
    ],
    "privateOrigins": [
      "https://connector.internal.example",
      "https://export.internal.example"
    ],
    "allowHttp": false,
    "allowPrivate": false,
    "timeoutMs": 15000,
    "maxResponseBytes": 1048576,
    "retries": 3
  },
  "connector": {
    "baseUrl": "https://connector.internal.example/management/",
    "statusPath": "transfers/{providerPid}",
    "startAckPath": "transfers/{providerPid}/started",
    "terminationAckPath": "transfers/{providerPid}/terminated",
    "supportsIdempotencyKey": true,
    "auth": {
      "type": "bearer",
      "env": "MOLIT_CONNECTOR_MANAGEMENT_TOKEN"
    }
  },
  "provisioners": {
    "road-data-export": {
      "baseUrl": "https://export.internal.example/control/",
      "provisionPath": "provision",
      "revokePath": "revoke",
      "supportsIdempotencyKey": true,
      "idempotentRevoke": true,
      "auth": {
        "type": "bearer",
        "env": "MOLIT_EXPORT_CONTROL_TOKEN"
      }
    }
  }
}
