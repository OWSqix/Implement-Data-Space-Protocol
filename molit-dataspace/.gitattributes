# The RC artifact lock hashes repository bytes. Text files must therefore
# have the same byte representation on Windows, Linux and macOS checkouts.
** text=auto eol=lf
profiles/molit-dcat-ap/releases/** text eol=lf -ident -filter -working-tree-encoding

# Do not apply newline conversion to packaged toolchains or binary evidence.
**/*.jar -text
**/*.zip -text
**/*.tgz -text
**/*.gz -text
**/*.png -text
**/*.jpg -text
**/*.jpeg -text
**/*.pdf -text

# Content-addressed evidence keeps its original bytes on every checkout.
# Digest registers hash the fetched bytes, so eol normalization on checkout
# breaks clean-clone verification (BS-CHECKOUT-NORMALIZATION).
standards/vendor/** -text
standards/mappings/** -text
tests/namespace/fixtures/** -text
fixtures/interoperability/** -text
