upstream molit_namespace_rc1 {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name data.molit.go.kr;
    if ($host != "data.molit.go.kr") { return 421; }
    return 308 https://data.molit.go.kr$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name data.molit.go.kr;
    if ($host != "data.molit.go.kr") { return 421; }
    server_tokens off;

    ssl_certificate /etc/ssl/molit/fullchain.pem;
    ssl_certificate_key /etc/ssl/molit/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MOLIT_TLS:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip off;
    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host data.molit.go.kr;
        proxy_pass http://molit_namespace_rc1;
        proxy_redirect off;
    }
}
