@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://data.molit.go.kr/id/example-invalid/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix molit: <https://data.molit.go.kr/def/molit-dcat-ap#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:dataset
    a dcat:Dataset,
        dcat:Resource ;
    dct:identifier "invalid-spoofed-concept" ;
    dct:title "통제어 사칭 오류 예시"@ko ;
    dct:description "입력 그래프가 허용되지 않은 품질 상태를 통제어 구성원이라고 자체 선언한다."@ko ;
    dct:publisher ex:publisher ;
    dct:modified "2026-07-12"^^xsd:date ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/TRAN>,
        <https://data.molit.go.kr/id/concept/domain/road> ;
    molit:qualityStatus ex:self-asserted-quality-status .

ex:publisher
    a foaf:Agent ;
    foaf:name "시험 발행기관"@ko .

ex:self-asserted-quality-status
    a skos:Concept ;
    skos:inScheme <https://data.molit.go.kr/scheme/quality-status> ;
    skos:prefLabel "입력 그래프가 만든 상태"@ko .
