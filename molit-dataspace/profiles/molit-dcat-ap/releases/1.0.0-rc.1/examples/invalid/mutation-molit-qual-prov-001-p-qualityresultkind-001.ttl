ex:observation-catalog a dcat:Catalog;
    dct:title "교통 관측 데이터 카탈로그 예시"@ko;
    dct:description "시간 해상도와 품질 측정값을 가진 교통량 관측 예시다."@ko;
    dct:publisher ex:traffic-office;
    dct:language <http://publications.europa.eu/resource/authority/language/KOR>;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    dct:issued "2026-07-12"^^xsd:date;
    dct:modified "2026-07-12"^^xsd:date;
    dct:conformsTo <https://data.molit.go.kr/profile/molit-dcat-ap/1.0.0-rc.1/quality>;
    dct:spatial ex:republic-of-korea-core;
    foaf:homepage <https://data.molit.go.kr/>;
    dcat:themeTaxonomy <http://publications.europa.eu/resource/authority/data-theme>, <https://data.molit.go.kr/scheme/domain>;
    dcat:dataset ex:traffic-observation;
    dcat:record ex:traffic-observation-record;
    molit:spatialDisclosureLevel <https://data.molit.go.kr/id/concept/spatial-disclosure-level/generalized>.
ex:traffic-office a foaf:Agent;
    dct:type <http://purl.org/adms/publishertype/NationalAuthority>;
    foaf:name "교통 관측 담당기관"@ko.
<https://creativecommons.org/licenses/by/4.0/> a dct:LicenseDocument;
    dct:type <http://purl.org/adms/licencetype/Attribution>.
ex:republic-of-korea-core a dct:Location;
    skos:prefLabel "대한민국"@ko, "Republic of Korea"@en;
    dcat:bbox "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POLYGON((124 33,132 33,132 39,124 39,124 33))"^^geo:wktLiteral;
    dcat:centroid "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(128 36)"^^geo:wktLiteral.
<https://data.molit.go.kr/> a foaf:Document.
ex:traffic-observation a dcat:Dataset, dcat:Resource, molit:ObservationDataset;
    dct:title "시간대별 교통량 관측"@ko;
    dct:description "2026년 7월의 시간대별 교통량 관측값을 제공한다."@ko;
    dct:publisher ex:traffic-office;
    dct:issued "2026-07-12"^^xsd:date;
    dct:modified "2026-07-12T09:00:00+09:00"^^xsd:dateTime;
    dct:spatial ex:republic-of-korea-core;
    molit:spatialDisclosureLevel <https://data.molit.go.kr/id/concept/spatial-disclosure-level/generalized>;
    dct:type ex:observation-dataset-type;
    dct:identifier "traffic-observation-hourly-2026-07";
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC>;
    dct:temporal ex:july-2026;
    dct:provenance ex:traffic-observation-provenance;
    dcat:temporalResolution "PT1H"^^xsd:duration;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/TRAN>, <https://data.molit.go.kr/id/concept/domain/road>;
    dcat:keyword "교통량"@ko, "시간대별 관측"@ko;
    dcat:contactPoint ex:traffic-data-contact;
    dcat:distribution ex:traffic-observation-csv;
    dqv:hasQualityMeasurement ex:traffic-completeness;
    molit:qualityStatus quality:assessed.
ex:traffic-observation-record a dcat:CatalogRecord;
    dct:title "시간대별 교통량 관측 레코드"@ko;
    dct:language <http://publications.europa.eu/resource/authority/language/KOR>;
    dct:issued "2026-07-12"^^xsd:date;
    dct:modified "2026-07-12"^^xsd:date;
    dct:conformsTo <https://data.molit.go.kr/profile/molit-dcat-ap/1.0.0-rc.1/quality>;
    adms:status <http://purl.org/adms/changetype/Updated>;
    foaf:primaryTopic ex:traffic-observation.
ex:observation-dataset-type a skos:Concept;
    skos:prefLabel "교통 관측 데이터셋"@ko, "Traffic observation dataset"@en.
ex:july-2026 a dct:PeriodOfTime;
    dcat:startDate "2026-07-01"^^xsd:date;
    dcat:endDate "2026-07-31"^^xsd:date.
ex:traffic-observation-provenance a dct:ProvenanceStatement;
    dct:description "교통 관측 담당기관이 승인한 2026년 7월 집계본에서 변환했다."@ko.
ex:traffic-data-contact a vcard:Kind;
    vcard:fn "교통 관측 데이터 담당부서"@ko;
    vcard:hasEmail <mailto:traffic-data@data.molit.go.kr>.
ex:traffic-observation-csv a dcat:Distribution;
    dct:title "시간대별 교통량 관측 CSV 배포본"@ko;
    dct:description "시간대별 집계 관측값을 CSV 파일로 제공한다."@ko;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    dct:issued "2026-07-12"^^xsd:date;
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV>;
    dcat:accessURL <https://data.molit.go.kr/dataset/traffic-observation/access>;
    dcat:downloadURL <https://data.molit.go.kr/dataset/traffic-observation/download>;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv>;
    dcatap:availability <http://publications.europa.eu/resource/authority/planned-availability/STABLE>.
ex:traffic-completeness a dqv:QualityMeasurement;
    dqv:computedOn ex:traffic-observation;
    dqv:isMeasurementOf metric:completeness;
    dqv:value 98.7;
    molit:qualityEvaluationMethod qmethod:whole-population;
    molit:qualityEvaluationScope "all published observation rows in the declared temporal extent";
    molit:qualityMappingStatement ex:traffic-completeness-mapping;
    sdmx-attribute:unitMeasure <http://qudt.org/vocab/unit/PERCENT>.
<https://data.molit.go.kr/dataset/traffic-observation/access> a rdfs:Resource.
<https://data.molit.go.kr/dataset/traffic-observation/download> a rdfs:Resource.
<https://www.iana.org/assignments/media-types/text/csv> a dct:MediaType.
ex:traffic-completeness-mapping a molit:QualityMappingStatement;
    molit:sourceQualityElement ex:source-completeness-element;
    molit:mappedQualityMetric metric:completeness;
    molit:qualityLossDisposition qloss:lossless.
ex:source-completeness-element a skos:Concept;
    skos:prefLabel "원천 완전성 측정항목"@ko, "Source completeness element"@en.
