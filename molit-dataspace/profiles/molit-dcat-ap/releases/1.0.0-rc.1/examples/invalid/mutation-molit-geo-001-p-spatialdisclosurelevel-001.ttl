    dct:modified "2026-07-11T23:00:00+09:00"^^xsd:dateTime;
    dct:spatial ex:republic-of-korea;
    dct:identifier "molit-road-network-2026-07";
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/MONTHLY>;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC>;
    dct:temporal ex:period-2026-07;
    dct:provenance ex:road-network-provenance;
    geodcatap:referenceSystem <http://www.opengis.net/def/crs/OGC/1.3/CRS84>;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/TRAN>, molit-domain:road;
    dcat:keyword "도로"@ko, "노드"@ko, "링크"@ko;
    dcat:contactPoint ex:road-data-contact;
