ex:sector-data-service-fixture
    a dcat:DataService, dcat:Resource ;
    dct:title "국토교통 분야 DataService 구조 예시"@ko ;
    dct:description "endpointURL, servesDataset과 국내 주제의 적합성만 시험하는 비운영 서비스 설명이다."@ko ;
    dct:publisher ex:fixture-publisher ;
    dct:license ex:fixture-license-pending ;
    dct:accessRights ex:fixture-public-access ;
    dcat:endpointURL <https://data.molit.go.kr/id/example/non-operational-endpoint> ;
    dcat:endpointDescription <https://data.molit.go.kr/id/example/non-operational-endpoint-description> ;
    dcat:servesDataset ex:road-rail-fixture,
        ex:aviation-logistics-fixture ;
    dcat:theme <https://data.molit.go.kr/id/concept/domain/transport>,
        <https://data.molit.go.kr/id/concept/domain/aviation>,
        <https://data.molit.go.kr/id/concept/domain/logistics> .

ex:fixture-publisher
    a foaf:Agent ;
    dct:type <http://purl.org/adms/publishertype/NationalAuthority> ;
    foaf:name "프로파일 적합성 시험 발행기관"@ko .

ex:fixture-contact
    a vcard:Kind ;
    vcard:fn "프로파일 적합성 시험 담당"@ko .

ex:fixture-provenance
    a dct:ProvenanceStatement ;
    dct:description "프로파일 적합성 시험을 위해 작성한 합성 메타데이터이며 운영 데이터가 아니다."@ko .

ex:republic-of-korea-sector-fixture
    a dct:Location ;
    skos:prefLabel "대한민국"@ko,
        "Republic of Korea"@en .

ex:fixture-dataset-type
    a skos:Concept ;
    skos:prefLabel "적합성 시험 데이터셋"@ko .

ex:fixture-public-access
    a dct:RightsStatement ;
    skos:prefLabel "공개 접근 시험값"@ko ;
    skos:note "승인된 국내 접근권한 코드가 아니며 fixture에서만 사용한다."@ko .

ex:fixture-license-pending
    a dct:LicenseDocument ;
    skos:prefLabel "라이선스 미확정 시험값"@ko ;
    skos:note "운영 라이선스를 주장하지 않는 fixture 전용 값이다."@ko .

