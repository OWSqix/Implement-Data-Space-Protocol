# 이 파일은 도메인별 구조를 시험하는 합성 fixture다. 실제 API나 데이터 제공을 주장하지 않는다.
ex:sector-catalog
    a dcat:Catalog ;
    dct:title "국토교통 분야별 적합성 시험 카탈로그"@ko ;
    dct:description "국토·도시, 주택·건축·부동산, 건설, 도로·철도, 항공·물류와 DataService 구조를 한 graph에서 시험한다."@ko ;
    dct:publisher ex:fixture-publisher ;
    dct:language <http://publications.europa.eu/resource/authority/language/KOR> ;
    dct:license ex:fixture-license-pending ;
    dct:issued "2026-07-13"^^xsd:date ;
    dct:modified "2026-07-13"^^xsd:date ;
    dct:conformsTo <https://data.molit.go.kr/profile/molit-dcat-ap/1.0.0-rc.1> ;
    dct:spatial ex:republic-of-korea-sector-fixture ;
    foaf:homepage <https://data.molit.go.kr/id/example/sector-catalog-page> ;
    dcat:themeTaxonomy <https://data.molit.go.kr/scheme/domain> ;
    dcat:dataset ex:land-urban-fixture,
        ex:housing-building-real-estate-fixture,
        ex:construction-fixture,
        ex:road-rail-fixture,
        ex:aviation-logistics-fixture ;
    dcat:record ex:land-urban-record,
        ex:housing-building-real-estate-record,
        ex:construction-record,
        ex:road-rail-record,
        ex:aviation-logistics-record ;
    dcat:service ex:sector-data-service-fixture ;
    molit:spatialDisclosureLevel <https://data.molit.go.kr/id/concept/spatial-disclosure-level/generalized> .

