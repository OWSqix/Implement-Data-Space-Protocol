    owl:versionInfo "1.0.0-rc.1" ;
    adms:status term-status:candidate .

<https://data.molit.go.kr/id/concept/spatial-disclosure-level/exact>
    rdfs:isDefinedBy <https://data.molit.go.kr/scheme/spatial-disclosure-level> ;
    owl:versionInfo "1.0.0-rc.1" ;
    adms:status term-status:candidate .

<https://data.molit.go.kr/id/concept/spatial-disclosure-level/generalized>
    rdfs:isDefinedBy <https://data.molit.go.kr/scheme/spatial-disclosure-level> ;
    owl:versionInfo "1.0.0-rc.1" ;
    adms:status term-status:candidate .

<https://data.molit.go.kr/id/concept/spatial-disclosure-level/grid>
    rdfs:isDefinedBy <https://data.molit.go.kr/scheme/spatial-disclosure-level> ;
