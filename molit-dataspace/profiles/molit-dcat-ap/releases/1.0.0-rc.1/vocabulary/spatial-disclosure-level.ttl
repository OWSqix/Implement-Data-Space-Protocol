@prefix dct: <http://purl.org/dc/terms/> .
@prefix disclosure: <https://data.molit.go.kr/id/concept/spatial-disclosure-level/> .
@prefix molit-scheme: <https://data.molit.go.kr/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

molit-scheme:spatial-disclosure-level
    a skos:ConceptScheme ;
    dct:issued "2026-07-12"^^xsd:date ;
    dct:title "공간 공개 정밀도"@ko ;
    skos:note "License for locally authored concepts is pending owner approval."@en ;
    skos:prefLabel "공간 공개 정밀도"@ko,
        "Spatial disclosure levels"@en ;
    skos:definition "공개 카탈로그의 공간정보가 profile 수준에서 그대로 게시되는지 제거되는지 표시하는 후보 분류체계. 접근권한 또는 보안등급이 아니다. RC.1 발행 Gate는 exact와 withheld만 허용한다."@ko,
        "A candidate scheme indicating whether spatial information is published without profile-level redaction or removed; it is not an access right or security classification. The RC.1 publication gate permits exact and withheld only."@en ;
    skos:hasTopConcept disclosure:exact,
        disclosure:generalized,
        disclosure:administrative-area,
        disclosure:bounding-box,
        disclosure:grid,
        disclosure:withheld .

disclosure:exact
    a skos:Concept ;
    skos:inScheme molit-scheme:spatial-disclosure-level ;
    skos:prefLabel "원 정밀도"@ko, "Exact"@en ;
    skos:definition "profile에 제출된 공간정보를 추가 일반화나 제거 없이 공개하는 수준. SHACL 통과가 제출값과 비공개 원천의 동일성을 입증하지는 않는다."@ko,
        "A level publishing the submitted spatial information without additional profile-level generalization or removal; SHACL conformance does not prove equality with a non-public source."@en ;
    skos:topConceptOf molit-scheme:spatial-disclosure-level .

disclosure:generalized
    a skos:Concept ;
    skos:inScheme molit-scheme:spatial-disclosure-level ;
    skos:prefLabel "일반화"@ko, "Generalized"@en ;
    skos:definition "좌표 반올림, 단순화 또는 집계를 적용해 원천보다 정밀도를 낮춘 수준."@ko,
        "A level with lower precision than the source after coordinate rounding, simplification or aggregation."@en ;
    skos:topConceptOf molit-scheme:spatial-disclosure-level .

disclosure:administrative-area
    a skos:Concept ;
    skos:inScheme molit-scheme:spatial-disclosure-level ;
    skos:prefLabel "행정구역"@ko, "Administrative area"@en ;
    skos:definition "개별 위치 대신 승인된 행정구역 코드 또는 경계까지만 공개한 수준."@ko,
        "A level disclosing only an approved administrative-area code or boundary instead of an individual location."@en ;
    skos:topConceptOf molit-scheme:spatial-disclosure-level .

disclosure:bounding-box
    a skos:Concept ;
    skos:inScheme molit-scheme:spatial-disclosure-level ;
    skos:prefLabel "경계 상자"@ko, "Bounding box"@en ;
    skos:definition "원 geometry 대신 그 범위를 포함하는 최소 또는 승인된 경계 상자만 공개한 수준."@ko,
        "A level disclosing only a minimum or approved bounding box containing the source geometry."@en ;
    skos:topConceptOf molit-scheme:spatial-disclosure-level .

disclosure:grid
    a skos:Concept ;
    skos:inScheme molit-scheme:spatial-disclosure-level ;
    skos:prefLabel "격자"@ko, "Grid"@en ;
    skos:definition "개별 위치를 승인된 격자 셀 또는 셀 단위 집계값으로 바꿔 공개한 수준."@ko,
        "A level replacing individual locations with approved grid cells or cell-level aggregates."@en ;
    skos:topConceptOf molit-scheme:spatial-disclosure-level .

disclosure:withheld
    a skos:Concept ;
    skos:inScheme molit-scheme:spatial-disclosure-level ;
    skos:prefLabel "비공개"@ko, "Withheld"@en ;
    skos:definition "공개 graph에 위치, 경계 상자, 중심점 또는 geometry를 제공하지 않는 수준."@ko,
        "A level at which no location, bounding box, centroid or geometry is supplied in the public graph."@en ;
    skos:topConceptOf molit-scheme:spatial-disclosure-level .

# RC.1 local-term governance. The candidate status is not institutional approval.
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix term-status: <https://data.molit.go.kr/id/concept/term-status/> .

<https://data.molit.go.kr/id/concept/spatial-disclosure-level/administrative-area>
    rdfs:isDefinedBy <https://data.molit.go.kr/scheme/spatial-disclosure-level> ;
    owl:versionInfo "1.0.0-rc.1" ;
    adms:status term-status:candidate .

<https://data.molit.go.kr/id/concept/spatial-disclosure-level/bounding-box>
