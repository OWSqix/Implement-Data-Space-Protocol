@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix status: <https://data.molit.go.kr/id/concept/term-status/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.molit.go.kr/scheme/term-status>
    a skos:ConceptScheme ;
    dct:issued "2026-07-13"^^xsd:date ;
    dct:title "국토교통 로컬 용어 상태"@ko,
        "MOLIT local-term status"@en ;
    skos:definition "국토교통 응용 프로파일이 직접 관리하는 용어의 검토와 사용 상태를 표시하는 후보 분류체계."@ko,
        "A candidate scheme indicating review and use status for terms maintained directly by the MOLIT application profile."@en ;
    skos:prefLabel "국토교통 로컬 용어 상태"@ko,
        "MOLIT local-term status"@en ;
    skos:hasTopConcept status:candidate,
        status:approved,
        status:deprecated ;
    owl:versionInfo "1.0.0-rc.1" ;
    adms:status status:candidate .

status:candidate
    a skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/scheme/term-status> ;
    skos:inScheme <https://data.molit.go.kr/scheme/term-status> ;
    skos:prefLabel "승인 전 후보"@ko,
        "Candidate pending approval"@en ;
    skos:definition "기술검토에 사용할 수 있지만 운영기관의 표준 또는 권위식별자로 승인되지 않은 상태."@ko,
        "Available for technical review but not approved as an institutional standard or authoritative identifier."@en ;
    skos:topConceptOf <https://data.molit.go.kr/scheme/term-status> ;
    owl:versionInfo "1.0.0-rc.1" ;
    adms:status status:candidate .

status:approved
    a skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/scheme/term-status> ;
    skos:inScheme <https://data.molit.go.kr/scheme/term-status> ;
    skos:prefLabel "승인됨"@ko,
        "Approved"@en ;
    skos:definition "지정된 운영기관과 적용범위에서 사용하도록 승인된 상태. 승인 evidence와 유효기간을 별도로 보존한다."@ko,
        "Approved for use by a designated operating authority and scope; approval evidence and validity are preserved separately."@en ;
    skos:topConceptOf <https://data.molit.go.kr/scheme/term-status> ;
    owl:versionInfo "1.0.0-rc.1" ;
    adms:status status:candidate .

status:deprecated
    a skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/scheme/term-status> ;
    skos:inScheme <https://data.molit.go.kr/scheme/term-status> ;
    skos:prefLabel "사용 중단"@ko,
        "Deprecated"@en ;
    skos:definition "신규 데이터에 사용하지 않으며 대체 용어 또는 tombstone 설명을 유지하는 상태."@ko,
        "No longer used for new data, while a replacement term or tombstone explanation is retained."@en ;
    skos:topConceptOf <https://data.molit.go.kr/scheme/term-status> ;
    owl:versionInfo "1.0.0-rc.1" ;
    adms:status status:candidate .

# Scheme-definition anchors.
<https://data.molit.go.kr/scheme/term-status> rdfs:isDefinedBy <https://data.molit.go.kr/scheme/term-status> .
