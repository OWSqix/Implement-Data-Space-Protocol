@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix molit: <https://data.molit.go.kr/def/molit-dcat-ap#> .
@prefix molit-status: <https://data.molit.go.kr/id/concept/term-status/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.molit.go.kr/def/molit-dcat-ap>
    a owl:Ontology ;
    owl:versionIRI <https://data.molit.go.kr/def/molit-dcat-ap/1.0.0-rc.1> ;
    owl:versionInfo "1.0.0-rc.1" ;
    adms:status molit-status:candidate ;
    dct:issued "2026-07-13"^^xsd:date ;
    dct:modified "2026-07-13"^^xsd:date ;
    dct:publisher [
        a foaf:Agent ;
        foaf:name "국토교통부 발행주체 후보"@ko,
            "Candidate MOLIT publishing agent"@en ;
        dct:type <https://data.molit.go.kr/candidate/concept/agent-type/unverified-publisher> ;
        rdfs:comment "기관 식별자와 발행권한은 운영기관 승인을 기다린다. 이 blank node를 Provider authority 또는 권위 기관 IRI로 사용하지 않는다."@ko,
            "The organization identifier and publishing authority await operating-authority approval. This blank node is not a Provider authority or an authoritative organization IRI."@en ;
        adms:status molit-status:candidate
    ] ;
    dct:title "국토교통 데이터 카탈로그 확장 온톨로지"@ko,
        "MOLIT data catalogue extension ontology"@en ;
    dct:description "DCAT 3와 DCAT-AP 3.0.1에 없는 국토교통 카탈로그 의미를 최소 범위로 정의한다. 이 후보 온톨로지는 기관 승인, 제공 권한 또는 전송 가능성을 스스로 증명하지 않는다."@ko,
        "Defines the minimum MOLIT catalogue semantics not supplied by DCAT 3 and DCAT-AP 3.0.1. This candidate ontology does not by itself prove institutional approval, provider authority or transfer availability."@en ;
    rdfs:comment "Release Candidate. Namespace publication, local-artifact licensing and owner approval remain pending."@en .

<https://data.molit.go.kr/candidate/concept/agent-type/unverified-publisher>
    a skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    skos:notation "unverified-publisher" ;
    skos:prefLabel "미승인 발행주체 후보"@ko,
        "Unverified candidate publisher"@en ;
    skos:definition "후보 artifact에 이름으로만 표시했으며 기관 식별자와 발행권한을 운영기관이 아직 승인하지 않은 발행주체 유형."@ko,
        "A publisher type used only by name on candidate artifacts where the operating authority has not yet approved an organization identifier or publishing authority."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

<https://data.molit.go.kr/profile/molit-dcat-ap/1.0.0-rc.1>
    a dct:Standard ;
    adms:status molit-status:candidate ;
    dct:title "국토교통 데이터 카탈로그 응용 프로파일 1.0.0-rc.1"@ko,
        "MOLIT Data Catalogue Application Profile 1.0.0-rc.1"@en ;
    dct:description "운영기관, namespace와 공개 라이선스 승인 전 후보판. Recommendation 또는 기관 표준이 아니다."@ko,
        "A candidate release pending operating-authority, namespace and public-license approval; it is not a Recommendation or institutional standard."@en ;
    dct:isVersionOf <https://data.molit.go.kr/profile/molit-dcat-ap> ;
    dct:issued "2026-07-13"^^xsd:date .

## Classes

molit:TransferableDataset
    a owl:Class ;
    owl:deprecated true ;
    rdfs:subClassOf dcat:Dataset ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "전송 설명이 있는 데이터셋"@ko,
        "Dataset with a transfer description"@en ;
    skos:definition "계약 또는 전송 절차에서 사용할 배포 설명을 하나 이상 가진 데이터셋. 이 유형의 선언만으로 현재 제공 권한, Connector 준비 상태 또는 전송 성공을 주장하지 않는다."@ko,
        "A dataset with one or more distribution descriptions intended for contract or transfer procedures. Declaring this type alone does not assert current provider authority, connector readiness or successful transfer."@en ;
    skos:changeNote "1.0.0-rc.1부터 신규 metadata에는 dcat:Dataset과 별도 molit:DataspaceOfferingMetadata를 사용한다. 기존 유형은 0.1.0 graph 읽기와 migration에만 보존한다."@ko,
        "From 1.0.0-rc.1, new metadata uses dcat:Dataset with a separate molit:DataspaceOfferingMetadata resource. This legacy type is retained only for reading and migrating 0.1.0 graphs."@en ;
    dct:isReplacedBy dcat:Dataset,
        molit:DataspaceOfferingMetadata ;
    rdfs:comment "Operational eligibility is decided outside the metadata graph by an approved authority registry and runtime controls."@en ;
    adms:status molit-status:deprecated ;
    owl:versionInfo "1.0.0-rc.1" .

molit:SpatialDataset
    a owl:Class ;
    rdfs:subClassOf dcat:Dataset ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "공간 데이터셋"@ko,
        "Spatial dataset"@en ;
    skos:definition "공간 범위 또는 지오메트리와 그 해석에 필요한 좌표참조체계를 기술하는 데이터셋."@ko,
        "A dataset describing a spatial extent or geometry and the coordinate reference system needed to interpret it."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:NetworkDataset
    a owl:Class ;
    rdfs:subClassOf molit:SpatialDataset ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 데이터셋"@ko,
        "Transport network dataset"@en ;
    skos:definition "도로, 철도, 정류장, 링크 또는 노드와 같이 판이 바뀔 수 있는 교통망 요소를 기술하는 공간 데이터셋."@ko,
        "A spatial dataset describing versioned transport-network elements such as roads, railways, stops, links or nodes."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:ObservationDataset
    a owl:Class ;
    rdfs:subClassOf dcat:Dataset ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "관측 데이터셋"@ko,
        "Observation dataset"@en ;
    skos:definition "교통량, 속도 또는 통행시간의 시계열 관측값을 제공하며 관측항목, 관측대상 유형, 집계, 결측 처리와 단위를 함께 기술하는 데이터셋. 시설 상태 관측은 RC.1 범위가 아니다."@ko,
        "A dataset providing time-dependent traffic-volume, speed or travel-time observations together with observed-property, subject-type, aggregation, missing-value and unit semantics; facility-status observations are outside RC.1."@en ;
    rdfs:seeAlso <http://www.w3.org/ns/sosa/ObservationCollection> ;
    rdfs:comment "The class describes catalogue metadata for a dataset. It is not declared equivalent to a SOSA observation or observation collection."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:TransferDistribution
    a owl:Class ;
    owl:deprecated true ;
    rdfs:subClassOf dcat:Distribution ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "전송 배포 설명"@ko,
        "Transfer distribution description"@en ;
    skos:definition "계약 절차에서 사용할 수 있는 파일 또는 고정 데이터 표현의 카탈로그 배포 설명. 실제 접근 승인과 일시적인 전송 주소는 운영 계층에서 별도로 판정한다."@ko,
        "A catalogue distribution description for a file or fixed data representation intended for a contract procedure. Actual access approval and transient transfer addresses are decided separately by the operational layer."@en ;
    skos:changeNote "1.0.0-rc.1부터 신규 metadata에는 dcat:Distribution을 사용하고 제공 준비상태는 molit:DataspaceOfferingMetadata에서 분리한다. 기존 유형은 0.1.0 graph migration에만 보존한다."@ko,
        "From 1.0.0-rc.1, new metadata uses dcat:Distribution and records offering readiness separately on molit:DataspaceOfferingMetadata. This legacy type is retained only for migrating 0.1.0 graphs."@en ;
    dct:isReplacedBy dcat:Distribution,
        molit:DataspaceOfferingMetadata ;
    adms:status molit-status:deprecated ;
    owl:versionInfo "1.0.0-rc.1" .

molit:NetworkReference
    a owl:Class ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 참조"@ko,
        "Network reference"@en ;
    skos:definition "발급기관, 망 식별자, 판, 요소 유형, snapshot checksum과 생명주기를 한 판정 단위로 보존하는 참조 객체."@ko,
        "A reference object preserving issuing authority, network identifier, edition, element types, snapshot checksum and lifecycle as one resolution unit."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:DataspaceOfferingMetadata
    a owl:Class ;
    rdfs:subClassOf dcat:Resource ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "데이터 스페이스 제공 메타데이터"@ko,
        "Dataspace offering metadata"@en ;
    skos:definition "데이터셋의 제공 의도, 준비상태와 자격 증거 참조를 기술하는 발견용 정보 객체. 이 객체는 DSP Offer, Agreement 또는 운영 승인 자체가 아니다."@ko,
        "A discovery information object describing an intention to offer a dataset, its readiness and references to qualification evidence. It is not itself a DSP Offer, Agreement or operational approval."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:QualityMappingStatement
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 매핑 명세"@ko,
        "Quality mapping statement"@en ;
    skos:definition "원천 품질 요소를 DQV metric으로 옮길 때 적용한 관계, 손실 처리와 역변환 가능성을 기록하는 명세."@ko,
        "A statement recording the relation, loss disposition and reversibility used when mapping a source quality element to a DQV metric."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

## Network properties

molit:networkReference
    a owl:ObjectProperty ;
    rdfs:domain molit:NetworkDataset ;
    rdfs:range molit:NetworkReference ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 참조"@ko,
        "network reference"@en ;
    skos:definition "데이터셋을 교통망 식별체계와 판을 보존하는 참조 객체에 연결한다."@ko,
        "Links a dataset to the reference object preserving its transport-network identifier system and edition."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:networkAuthority
    a owl:ObjectProperty ;
    rdfs:domain molit:NetworkReference ;
    rdfs:range foaf:Agent ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 식별자 발급기관"@ko,
        "network identifier authority"@en ;
    skos:definition "교통망 식별자와 판의 유일성 범위를 관리하는 발급기관."@ko,
        "The issuing authority governing the uniqueness scope of a transport-network identifier and edition."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:networkIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain molit:NetworkReference ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 식별자"@ko,
        "network identifier"@en ;
    skos:definition "발급기관의 범위 안에서 교통망 또는 식별자 체계를 식별하는 문자열."@ko,
        "A string identifying a transport network or identifier system within the issuing authority's scope."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:networkVersion
    a owl:DatatypeProperty ;
    rdfs:domain molit:NetworkReference ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 판"@ko,
        "network edition"@en ;
    skos:definition "발급기관이 공개한 교통망 상태의 판 또는 snapshot 식별자. 소프트웨어 버전을 뜻하지 않는다."@ko,
        "The edition or snapshot identifier of a network state published by its authority; it is not a software version."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:networkElementType
    a owl:ObjectProperty ;
    rdfs:domain molit:NetworkReference ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 요소 유형"@ko,
        "network element type"@en ;
    skos:definition "참조된 교통망에 포함되는 노드, 링크, 구간, 정류장 또는 시설의 유형."@ko,
        "The type of node, link, section, stop or facility included in the referenced transport network."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:networkSnapshotChecksum
    a owl:DatatypeProperty ;
    rdfs:domain molit:NetworkReference ;
    rdfs:range xsd:hexBinary ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 snapshot 체크섬"@ko,
        "network snapshot checksum"@en ;
    skos:definition "교통망 판을 구성하는 고정 배포물 또는 승인 manifest의 byte 동일성을 확인하는 SHA-256 체크섬 값. 알고리즘은 이 release에서 SHA-256으로 고정한다."@ko,
        "A SHA-256 checksum value used to verify the byte identity of the fixed distribution or approved manifest constituting a network edition. This release fixes the algorithm to SHA-256."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:networkLifecycleStatus
    a owl:ObjectProperty ;
    rdfs:domain molit:NetworkReference ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 판 생명주기 상태"@ko,
        "network-edition lifecycle status"@en ;
    skos:definition "교통망 판이 후보, 현행, 대체됨 또는 철회됨 중 어느 상태인지 나타내는 통제값."@ko,
        "A controlled value stating whether a network edition is a candidate, current, superseded or withdrawn."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:networkValidFrom
    a owl:DatatypeProperty ;
    rdfs:domain molit:NetworkReference ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 판 유효 시작"@ko,
        "network-edition valid from"@en ;
    skos:definition "해당 교통망 판을 식별자 해석과 조인에 사용하기 시작하는 날짜."@ko,
        "The date from which the network edition is used for identifier resolution and joins."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:networkValidUntil
    a owl:DatatypeProperty ;
    rdfs:domain molit:NetworkReference ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "교통망 판 유효 종료"@ko,
        "network-edition valid until"@en ;
    skos:definition "해당 교통망 판을 현행 판으로 해석하는 마지막 날짜. 값이 없으면 종료일을 아직 정하지 않은 것이다."@ko,
        "The last date on which the network edition is interpreted as current; absence means that no end date has yet been assigned."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

## Observation properties

molit:observedProperty
    a owl:ObjectProperty ;
    rdfs:domain molit:ObservationDataset ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "관측항목"@ko,
        "observed property"@en ;
    skos:definition "데이터셋에 수록된 값이 측정하거나 판정한 현상 또는 특성의 종류."@ko,
        "The kind of phenomenon or characteristic measured or assessed by values contained in the dataset."@en ;
    rdfs:seeAlso <http://www.w3.org/ns/sosa/observedProperty> ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:observationSubjectType
    a owl:ObjectProperty ;
    rdfs:domain molit:ObservationDataset ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "관측대상 유형"@ko,
        "observation subject type"@en ;
    skos:definition "관측값이 적용되는 지점, 구간, 망 요소, 시설, 차량 집단 또는 지역의 유형."@ko,
        "The type of site, section, network element, facility, vehicle population or area to which observations apply."@en ;
    rdfs:seeAlso <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:observationAggregation
    a owl:ObjectProperty ;
    rdfs:domain molit:ObservationDataset ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "관측 집계방식"@ko,
        "observation aggregation method"@en ;
    skos:definition "원 관측값을 순간값, 합계, 평균, 최솟값, 최댓값 또는 중앙값으로 구성한 방식을 나타내는 통제값."@ko,
        "A controlled value stating whether source observations are represented as instantaneous values, sums, means, minima, maxima or medians."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:aggregationPeriod
    a owl:DatatypeProperty ;
    rdfs:domain molit:ObservationDataset ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "관측 집계기간"@ko,
        "observation aggregation period"@en ;
    skos:definition "하나의 집계값을 계산하는 시간창의 길이. 데이터셋의 최소 시간해상도와 같다고 가정하지 않는다."@ko,
        "The duration of the time window used to calculate one aggregate value; it is not assumed to equal the dataset's minimum temporal resolution."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:missingValuePolicy
    a owl:ObjectProperty ;
    rdfs:domain molit:ObservationDataset ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "결측값 처리정책"@ko,
        "missing-value policy"@en ;
    skos:definition "누락된 관측을 원자료 결측 유지, 명시적 결측 코드, 집계 제외 또는 승인된 대치 중 어느 방식으로 처리했는지 나타내는 통제값."@ko,
        "A controlled value stating whether absent observations are preserved as missing, encoded explicitly, excluded from aggregation or replaced by an approved imputation method."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:observationUnit
    a owl:ObjectProperty ;
    rdfs:domain molit:ObservationDataset ;
    rdfs:range qudt:Unit ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "관측값 단위"@ko,
        "observation-value unit"@en ;
    skos:definition "관측값의 수치 의미를 해석하는 QUDT 단위. 품질 측정값의 단위와 구분한다."@ko,
        "The QUDT unit used to interpret observation values; it is distinct from the unit of a quality measurement."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

## Offering metadata properties

molit:describesOfferingDataset
    a owl:ObjectProperty ;
    rdfs:domain molit:DataspaceOfferingMetadata ;
    rdfs:range dcat:Dataset ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "제공 대상 데이터셋"@ko,
        "describes offering dataset"@en ;
    skos:definition "제공 메타데이터가 발견용으로 기술하는 데이터셋을 연결한다."@ko,
        "Links an offering-metadata resource to the dataset it describes for discovery."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:offeringReadinessStatus
    a owl:ObjectProperty ;
    rdfs:domain molit:DataspaceOfferingMetadata ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "제공 준비상태"@ko,
        "offering readiness status"@en ;
    skos:definition "제공 후보가 metadata 작성, 외부 자격검토, 중단 또는 철회 중 어느 단계에 있는지 나타내는 통제값."@ko,
        "A controlled value stating whether an offering candidate is being described, awaiting external qualification, suspended or withdrawn."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:qualificationEvidence
    a owl:ObjectProperty ;
    rdfs:domain molit:DataspaceOfferingMetadata ;
    rdfs:range prov:Entity ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "제공 자격 증거 참조"@ko,
        "qualification evidence reference"@en ;
    skos:definition "제공 권한, 위임, 유효기간 또는 Connector 준비상태를 판단할 때 사용한 비공개 또는 공개 증거 객체의 참조. 참조의 존재만으로 증거의 진위를 보증하지 않는다."@ko,
        "A reference to a public or non-public evidence object used to assess provider authority, delegation, validity or connector readiness. Presence of the reference does not establish evidence authenticity."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

## Quality properties

molit:qualityStatus
    a owl:ObjectProperty ;
    rdfs:domain dcat:Dataset ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 평가 상태"@ko,
        "quality assessment status"@en ;
    skos:definition "데이터셋에 대한 품질 평가 절차의 진행 또는 판정 상태. 상태만으로 측정값이나 합격을 주장하지 않는다."@ko,
        "The progress or decision state of a quality-assessment procedure for a dataset; the status alone does not assert a measurement or a passing result."@en ;
    rdfs:seeAlso dqv:hasQualityMeasurement ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:qualityEvaluationMethod
    a owl:ObjectProperty ;
    rdfs:domain dqv:QualityMeasurement ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 평가 방법"@ko,
        "quality evaluation method"@en ;
    skos:definition "품질 측정값을 산출한 절차의 방법 유형을 분류한다. RC.1은 실행 알고리즘, 매개변수, 수행주체나 재현 가능성을 이 값만으로 주장하지 않는다."@ko,
        "Classifies the method category of the procedure that produced a quality measurement; RC.1 does not use this value alone to identify an executable algorithm, parameters, agent or reproducibility."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:qualityEvaluationScope
    a owl:DatatypeProperty ;
    rdfs:domain dqv:QualityMeasurement ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 평가 범위"@ko,
        "quality evaluation scope"@en ;
    skos:definition "품질 측정값을 Dataset 전체로 오해하지 않도록 실제 평가 모집단, 표본, 속성 또는 기간을 기술하는 문자열."@ko,
        "A string describing the evaluated population, sample, attribute or period so that a measurement is not mistaken for a whole-dataset result."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:qualityResultConcept
    a owl:ObjectProperty ;
    rdfs:domain dqv:QualityMeasurement ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 결과 개념"@ko,
        "quality result concept"@en ;
    skos:definition "범주형 품질 결과의 통제 개념을 가리킨다. DQV의 dqv:value에는 이 개념의 코드나 표기값을 literal로 기록한다."@ko,
        "Links a categorical quality result to its controlled concept while dqv:value retains a literal code or notation as required by DQV."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:qualityResultKind
    a owl:ObjectProperty ;
    rdfs:domain dqv:QualityMeasurement ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 결과 유형"@ko,
        "quality result kind"@en ;
    skos:definition "품질 결과가 수치, 논리, 범주 또는 서술 중 어느 표현을 사용하는지 나타내는 통제값."@ko,
        "A controlled value stating whether a quality result is quantitative, boolean, categorical or descriptive."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:qualityMappingStatement
    a owl:ObjectProperty ;
    rdfs:domain dqv:QualityMeasurement ;
    rdfs:range molit:QualityMappingStatement ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 매핑 명세"@ko,
        "quality mapping statement"@en ;
    skos:definition "품질 측정값을 원천 품질 요소, 대상 DQV metric, 손실 처리와 역변환 조건을 기록한 별도 매핑 명세에 연결한다."@ko,
        "Links a quality measurement to a separate mapping statement recording the source quality element, target DQV metric, loss disposition and reverse-mapping conditions."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:sourceQualityElement
    a owl:ObjectProperty ;
    rdfs:domain molit:QualityMappingStatement ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "원천 품질 요소"@ko,
        "source quality element"@en ;
    skos:definition "품질 매핑의 입력이 되는 원천 표준 또는 시스템의 품질 요소 식별자."@ko,
        "The identifier of a quality element in the source standard or system used as input to a quality mapping."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:mappedQualityMetric
    a owl:ObjectProperty ;
    rdfs:domain molit:QualityMappingStatement ;
    rdfs:range dqv:Metric ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "대상 품질 측정항목"@ko,
        "mapped quality metric"@en ;
    skos:definition "원천 품질 요소가 변환되는 DQV 품질 측정항목."@ko,
        "The DQV quality metric to which the source quality element is mapped."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:qualityLossDisposition
    a owl:ObjectProperty ;
    rdfs:domain molit:QualityMappingStatement ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 매핑 손실 처리"@ko,
        "quality-mapping loss disposition"@en ;
    skos:definition "품질 매핑이 무손실, 가역 손실, 비가역 손실, 미매핑 또는 게시 제외 중 어느 상태인지 나타내는 통제값."@ko,
        "A controlled value stating whether a quality mapping is lossless, reversibly lossy, irreversibly lossy, unmapped or excluded from publication."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:qualityLossNote
    a owl:DatatypeProperty ;
    rdfs:domain molit:QualityMappingStatement ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "품질 매핑 손실 설명"@ko,
        "quality-mapping loss note"@en ;
    skos:definition "대상 표현에서 보존되지 않는 원천 의미와 역변환 조건을 사람이 검토할 수 있도록 설명한 문장."@ko,
        "A human-reviewable statement explaining source semantics not preserved by the target representation and any reverse-mapping conditions."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

## Publication and constraint annotations

molit:spatialDisclosureLevel
    a owl:ObjectProperty ;
    rdfs:domain dcat:Resource ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "공간 공개 정밀도"@ko,
        "spatial disclosure level"@en ;
    skos:definition "공개 카탈로그에서 제공하는 공간 범위의 일반화 수준. 보안 등급이나 접근 권한을 대신하지 않는다."@ko,
        "The generalization level of a spatial extent exposed in a public catalogue; it does not replace a security classification or access right."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:requirementId
    a owl:AnnotationProperty ;
    rdfs:domain sh:Shape ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "요구사항 식별자"@ko,
        "requirement identifier"@en ;
    skos:definition "SHACL 제약을 사람이 읽는 명세와 시험 항목에 연결하는 안정 식별자."@ko,
        "A stable identifier linking a SHACL constraint to its human-readable specification and test cases."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:remediation
    a owl:AnnotationProperty ;
    rdfs:domain sh:Shape ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "수정 지침"@ko,
        "remediation"@en ;
    skos:definition "제약 위반을 수정하기 위한 운영 지침."@ko,
        "Operational guidance for correcting a constraint violation."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .

molit:controlOwner
    a owl:AnnotationProperty ;
    rdfs:domain sh:Shape ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://data.molit.go.kr/def/molit-dcat-ap> ;
    rdfs:label "통제 책임 역할"@ko,
        "control owner role"@en ;
    skos:definition "제약의 의미와 변경을 관리하는 책임 역할 식별자."@ko,
        "An identifier for the role accountable for the meaning and change control of a constraint."@en ;
    adms:status molit-status:candidate ;
    owl:versionInfo "1.0.0-rc.1" .
