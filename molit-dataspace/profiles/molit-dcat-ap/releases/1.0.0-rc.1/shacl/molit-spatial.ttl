@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix disclosure: <https://data.molit.go.kr/id/concept/spatial-disclosure-level/> .
@prefix geodcatap: <http://data.europa.eu/930/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix molit: <https://data.molit.go.kr/def/molit-dcat-ap#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#SpatialDatasetShape>
    a sh:NodeShape ;
    sh:targetClass molit:SpatialDataset ;
    molit:requirementId "MOLIT-GEO-001" ;
    molit:controlOwner "geospatial-governance" ;
    sh:property [ molit:requirementId "MOLIT-GEO-001-P-TYPE-001" ;
        sh:path rdf:type ;
        sh:hasValue dcat:Dataset ;
        sh:message "확장 유형과 함께 dcat:Dataset 유형을 명시해야 한다."@ko
    ], [ molit:requirementId "MOLIT-GEO-001-P-REFERENCESYSTEM-001" ;
        sh:path geodcatap:referenceSystem ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:in (
            <http://www.opengis.net/def/crs/OGC/1.3/CRS84>
            <http://www.opengis.net/def/crs/EPSG/0/4326>
            <http://www.opengis.net/def/crs/EPSG/0/3857>
            <http://www.opengis.net/def/crs/EPSG/0/4737>
            <http://www.opengis.net/def/crs/EPSG/0/5179>
            <http://www.opengis.net/def/crs/EPSG/0/5185>
            <http://www.opengis.net/def/crs/EPSG/0/5186>
            <http://www.opengis.net/def/crs/EPSG/0/5187>
            <http://www.opengis.net/def/crs/EPSG/0/5188>
        ) ;
        sh:message "공간 데이터셋에는 OGC CRS IRI를 GeoDCAT-AP referenceSystem으로 지정해야 한다."@ko
    ], [ molit:requirementId "MOLIT-GEO-001-P-SPATIALDISCLOSURELEVEL-001" ;
        sh:path molit:spatialDisclosureLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            disclosure:exact
            disclosure:withheld
        ) ;
        sh:message "RC.1 발행 graph의 공간 공개 수준은 기계 검증 가능한 exact 또는 withheld IRI여야 한다."@ko
    ], [ molit:requirementId "MOLIT-GEO-001-P-SPATIALRESOLUTIONINMETERS-001" ;
        sh:path dcat:spatialResolutionInMeters ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:message "공간 해상도는 0보다 큰 미터 단위 xsd:decimal이어야 한다."@ko
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path molit:spatialDisclosureLevel ;
                sh:hasValue disclosure:withheld
            ] ;
            sh:property [ sh:path dct:spatial ; sh:maxCount 0 ]
        ]
        [
            sh:property [
                sh:path molit:spatialDisclosureLevel ;
                sh:hasValue disclosure:exact
            ] ;
            sh:property [
                sh:path dct:spatial ;
                sh:minCount 1 ;
                sh:class dct:Location
            ]
        ]
    ) ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path molit:spatialDisclosureLevel ;
                    sh:hasValue disclosure:withheld
                ]
            ]
        ]
        [
            sh:property [ sh:path dct:spatial ; sh:maxCount 0 ] ;
            sh:property [ sh:path dcat:bbox ; sh:maxCount 0 ] ;
            sh:property [ sh:path dcat:centroid ; sh:maxCount 0 ] ;
            sh:property [ sh:path locn:geometry ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:defaultGeometry ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasDefaultGeometry ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasGeometry ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasBoundingBox ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasCentroid ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasSerialization ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asWKT ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asGML ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asGeoJSON ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asKML ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asDGGS ; sh:maxCount 0 ]
        ]
    ) ;
    sh:message "공간 공개 수준이 비공개이면 location, bbox, centroid 또는 geometry serialization을 공개 graph에 넣을 수 없다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#SpatialDisclosureSafetyShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf molit:spatialDisclosureLevel ;
    molit:requirementId "MOLIT-GEO-DISCLOSURE-001" ;
    molit:controlOwner "security-privacy-review" ;
    sh:property [
        molit:requirementId "MOLIT-GEO-DISCLOSURE-001-P-SPATIALDISCLOSURELEVEL-001" ;
        sh:path molit:spatialDisclosureLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( disclosure:exact disclosure:withheld )
    ] ;
    sh:xone (
        [
            sh:property [ sh:path molit:spatialDisclosureLevel ; sh:hasValue disclosure:exact ] ;
            sh:property [ sh:path dct:spatial ; sh:minCount 1 ; sh:class dct:Location ]
        ]
        [
            sh:property [ sh:path molit:spatialDisclosureLevel ; sh:hasValue disclosure:withheld ] ;
            sh:property [ sh:path dct:spatial ; sh:maxCount 0 ] ;
            sh:property [ sh:path dcat:bbox ; sh:maxCount 0 ] ;
            sh:property [ sh:path dcat:centroid ; sh:maxCount 0 ] ;
            sh:property [ sh:path locn:geometry ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:defaultGeometry ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasDefaultGeometry ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasGeometry ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasBoundingBox ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasCentroid ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:hasSerialization ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asWKT ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asGML ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asGeoJSON ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asKML ; sh:maxCount 0 ] ;
            sh:property [ sh:path geo:asDGGS ; sh:maxCount 0 ]
        ]
    ) ;
    sh:message "공간 공개 수준은 exact 또는 withheld 하나여야 한다. exact에는 location이 필요하고 withheld에는 location·bbox·centroid·geometry를 둘 수 없다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#SpatialDisclosureSubjectTypeShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf molit:spatialDisclosureLevel ;
    molit:requirementId "MOLIT-GEO-DISCLOSURE-002" ;
    molit:controlOwner "geospatial-governance" ;
    sh:or (
        [
            sh:property [ sh:path rdf:type ; sh:hasValue dcat:Dataset ]
        ]
        [ sh:property [ sh:path rdf:type ; sh:hasValue dcat:Catalog ] ]
        [ sh:property [ sh:path rdf:type ; sh:hasValue dcat:DatasetSeries ] ]
        [ sh:property [ sh:path rdf:type ; sh:hasValue dcat:DataService ] ]
    ) ;
    sh:message "공간 공개 수준은 Dataset, Catalog, DatasetSeries 또는 DataService에만 지정한다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#LocationGeometryLinkShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf dcat:bbox,
        dcat:centroid,
        locn:geometry,
        geo:defaultGeometry,
        geo:hasDefaultGeometry,
        geo:hasGeometry,
        geo:hasBoundingBox,
        geo:hasCentroid ;
    molit:requirementId "MOLIT-GEO-LINK-001" ;
    molit:controlOwner "geospatial-governance" ;
    sh:property [ molit:requirementId "MOLIT-GEO-LINK-001-P-PATH-BFC98936CC-001" ;
        sh:path [ sh:inversePath dct:spatial ] ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path molit:spatialDisclosureLevel ;
                sh:minCount 1
            ]
        ] ;
        sh:message "geometry를 사용하는 모든 Catalog·Dataset·DatasetSeries·DataService에 공간 공개 수준이 있어야 한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#GeometryLiteralLinkShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf geo:asWKT,
        geo:asGML,
        geo:asGeoJSON,
        geo:asKML,
        geo:asDGGS,
        geo:hasSerialization ;
    molit:requirementId "MOLIT-GEO-LINK-002" ;
    molit:controlOwner "geospatial-governance" ;
    sh:property [ molit:requirementId "MOLIT-GEO-LINK-002-P-PATH-D6567CFAEC-001" ;
        sh:path [
            sh:alternativePath (
                (
                    [ sh:inversePath locn:geometry ]
                    [ sh:inversePath dct:spatial ]
                )
                (
                    [ sh:inversePath geo:hasGeometry ]
                    [ sh:inversePath dct:spatial ]
                )
                (
                    [ sh:inversePath geo:hasDefaultGeometry ]
                    [ sh:inversePath dct:spatial ]
                )
                (
                    [ sh:inversePath geo:defaultGeometry ]
                    [ sh:inversePath dct:spatial ]
                )
                (
                    [ sh:inversePath geo:hasBoundingBox ]
                    [ sh:inversePath dct:spatial ]
                )
                (
                    [ sh:inversePath geo:hasCentroid ]
                    [ sh:inversePath dct:spatial ]
                )
                [ sh:inversePath dct:spatial ]
            )
        ] ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path molit:spatialDisclosureLevel ;
                sh:minCount 1
            ]
        ] ;
        sh:message "geometry serialization을 사용하는 모든 카탈로그 자원에 공간 공개 수준이 있어야 한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#UnsupportedGeometrySerializationShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf geo:asGeoJSON,
        geo:asKML,
        geo:asDGGS,
        geo:hasSerialization ;
    molit:requirementId "MOLIT-GEO-ENCODING-005" ;
    molit:controlOwner "geospatial-governance" ;
    sh:property [ molit:requirementId "MOLIT-GEO-ENCODING-005-P-ASGEOJSON-001" ; sh:path geo:asGeoJSON ; sh:maxCount 0 ] ;
    sh:property [ molit:requirementId "MOLIT-GEO-ENCODING-005-P-ASKML-001" ; sh:path geo:asKML ; sh:maxCount 0 ] ;
    sh:property [ molit:requirementId "MOLIT-GEO-ENCODING-005-P-ASDGGS-001" ; sh:path geo:asDGGS ; sh:maxCount 0 ] ;
    sh:property [ molit:requirementId "MOLIT-GEO-ENCODING-005-P-HASSERIALIZATION-001" ; sh:path geo:hasSerialization ; sh:maxCount 0 ] ;
    sh:message "1.0.0-rc.1 공개 profile은 CRS를 검증할 수 있는 WKT와 GML geometry serialization만 허용한다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#WktGeometryCrsShape>
    a sh:NodeShape ;
    sh:targetObjectsOf geo:asWKT ;
    molit:requirementId "MOLIT-GEO-ENCODING-001" ;
    molit:controlOwner "geospatial-governance" ;
    sh:datatype geo:wktLiteral ;
    sh:pattern "^<http://www[.]opengis[.]net/def/crs/(OGC/1[.]3/CRS84|EPSG/0/(4326|3857|5179|5186))>\\s+" ;
    sh:message "GeoSPARQL WKT literal은 선두에 CRS84, EPSG:4326, 3857, 5179 또는 5186 IRI를 명시해야 한다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#GmlGeometryCrsShape>
    a sh:NodeShape ;
    sh:targetObjectsOf geo:asGML ;
    molit:requirementId "MOLIT-GEO-ENCODING-002" ;
    molit:controlOwner "geospatial-governance" ;
    sh:datatype geo:gmlLiteral ;
    sh:pattern "^\\s*(<[?]xml[^>]*>\\s*)?<[^>]*\\ssrsName\\s*=\\s*['\u0022]http://www[.]opengis[.]net/def/crs/(OGC/1[.]3/CRS84|EPSG/0/(4326|3857|5179|5186))['\u0022][^>]*>" ;
    sh:message "GeoSPARQL GML literal의 루트 geometry 요소는 CRS84, EPSG:4326, 3857, 5179 또는 5186 srsName을 명시해야 한다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#BoundingGeometryCrsShape>
    a sh:NodeShape ;
    sh:targetObjectsOf dcat:bbox,
        dcat:centroid ;
    molit:requirementId "MOLIT-GEO-ENCODING-003" ;
    molit:controlOwner "geospatial-governance" ;
    sh:or (
        [
            sh:datatype geo:wktLiteral ;
            sh:pattern "^<http://www[.]opengis[.]net/def/crs/(OGC/1[.]3/CRS84|EPSG/0/(4326|3857|5179|5186))>\\s+"
        ]
        [
            sh:datatype geo:gmlLiteral ;
            sh:pattern "^\\s*(<[?]xml[^>]*>\\s*)?<[^>]*\\ssrsName\\s*=\\s*['\u0022]http://www[.]opengis[.]net/def/crs/(OGC/1[.]3/CRS84|EPSG/0/(4326|3857|5179|5186))['\u0022][^>]*>"
        ]
    ) ;
    sh:message "bbox와 centroid는 CRS84, EPSG:4326, 3857, 5179 또는 5186을 명시한 WKT 또는 GML literal이어야 한다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#LocationGeometryEncodingShape>
    a sh:NodeShape ;
    sh:targetObjectsOf locn:geometry ;
    molit:requirementId "MOLIT-GEO-ENCODING-004" ;
    molit:controlOwner "geospatial-governance" ;
    sh:or (
        [ sh:nodeKind sh:BlankNodeOrIRI ]
        [
            sh:datatype geo:wktLiteral ;
            sh:pattern "^<http://www[.]opengis[.]net/def/crs/(OGC/1[.]3/CRS84|EPSG/0/(4326|3857|5179|5186))>\\s+"
        ]
        [
            sh:datatype geo:gmlLiteral ;
            sh:pattern "^\\s*(<[?]xml[^>]*>\\s*)?<[^>]*\\ssrsName\\s*=\\s*['\u0022]http://www[.]opengis[.]net/def/crs/(OGC/1[.]3/CRS84|EPSG/0/(4326|3857|5179|5186))['\u0022][^>]*>"
        ]
    ) ;
    sh:message "locn:geometry는 geometry node IRI·blank node 또는 CRS84, EPSG:4326, 3857, 5179, 5186을 명시한 WKT·GML literal이어야 한다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#WktGeometryTypeShape>
    a sh:NodeShape ;
    sh:targetObjectsOf geo:asWKT ;
    molit:requirementId "MOLIT-GEO-TYPE-001" ;
    molit:controlOwner "geospatial-governance" ;
    sh:datatype geo:wktLiteral ;
    sh:pattern "^<http://www[.]opengis[.]net/def/crs/(OGC/1[.]3/CRS84|EPSG/0/(4326|3857|5179|5186))>\\s+(POINT|LINESTRING|POLYGON)\\s*[(]" ;
    sh:flags "i" ;
    sh:message "The candidate WKT subset supports explicit-CRS 2D Point, LineString and single-ring Polygon only."@en .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#GmlGeometryTypeShape>
    a sh:NodeShape ;
    sh:targetObjectsOf geo:asGML ;
    molit:requirementId "MOLIT-GEO-TYPE-002" ;
    molit:controlOwner "geospatial-governance" ;
    sh:datatype geo:gmlLiteral ;
    sh:pattern "^\\s*(<[?]xml[^>]*>\\s*)?<(?:[A-Za-z_][A-Za-z0-9_.-]*:)?Point(?:\\s|>)" ;
    sh:message "The candidate GML subset supports GML 3.2 Point only."@en .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#BoundingBoxGeometryTypeShape>
    a sh:NodeShape ;
    sh:targetObjectsOf dcat:bbox ;
    molit:requirementId "MOLIT-GEO-TYPE-003" ;
    molit:controlOwner "geospatial-governance" ;
    sh:datatype geo:wktLiteral ;
    sh:pattern "^<[^>]+>\\s+POLYGON\\s*[(][(]" ;
    sh:flags "i" ;
    sh:message "dcat:bbox must be a closed, single-ring 2D WKT Polygon in the candidate profile."@en .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#CentroidGeometryTypeShape>
    a sh:NodeShape ;
    sh:targetObjectsOf dcat:centroid ;
    molit:requirementId "MOLIT-GEO-TYPE-004" ;
    molit:controlOwner "geospatial-governance" ;
    sh:datatype geo:wktLiteral ;
    sh:pattern "^<[^>]+>\\s+POINT\\s*[(]" ;
    sh:flags "i" ;
    sh:message "dcat:centroid must be a 2D WKT Point in the candidate profile."@en .
