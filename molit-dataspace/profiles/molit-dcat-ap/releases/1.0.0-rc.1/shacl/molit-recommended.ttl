@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix molit: <https://data.molit.go.kr/def/molit-dcat-ap#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#DatasetContactRecommendation>
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    molit:requirementId "MOLIT-REC-DS-001" ;
    molit:controlOwner "dataset-steward" ;
    sh:property [ molit:requirementId "MOLIT-REC-DS-001-P-CONTACTPOINT-001" ;
        sh:path dcat:contactPoint ;
        sh:minCount 1 ;
        sh:class vcard:Kind ;
        sh:severity sh:Warning ;
        sh:message "운영 문의를 받을 기관 연락 지점을 권고한다. 승인된 기관 role mailbox를 사용하며 1.0.0-rc.1에서는 전화번호를 게시하지 않는다."@ko
    ], [ molit:requirementId "MOLIT-REC-DS-001-P-PROVENANCE-001" ;
        sh:path dct:provenance ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "공개 가능한 기관 단위 계보 설명을 권고한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#OfferingQualificationEvidenceRecommendation>
    a sh:NodeShape ;
    sh:targetClass molit:DataspaceOfferingMetadata ;
    molit:requirementId "MOLIT-REC-QUAL-001" ;
    molit:controlOwner "data-quality" ;
    sh:property [ molit:requirementId "MOLIT-REC-QUAL-001-P-QUALIFICATIONEVIDENCE-001" ;
        sh:path molit:qualificationEvidence ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:message "운영 자격을 검토할 때 사용하는 외부 registry 증거 IRI를 권고한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#DistributionChecksumRecommendation>
    a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    molit:requirementId "MOLIT-REC-DIST-001" ;
    molit:controlOwner "data-delivery" ;
    sh:property [ molit:requirementId "MOLIT-REC-DIST-001-P-CHECKSUM-001" ;
        sh:path spdx:checksum ;
        sh:minCount 1 ;
        sh:class spdx:Checksum ;
        sh:severity sh:Warning ;
        sh:message "파일 배포본에는 SPDX checksum을 권고한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/1.0.0-rc.1#LocalDeprecatedTransferTypeShape>
    a sh:NodeShape ;
    sh:targetClass molit:TransferableDataset,
        molit:TransferDistribution ;
    molit:requirementId "MOLIT-DEPRECATED-LOCAL-001" ;
    molit:controlOwner "metadata-governance" ;
    sh:in () ;
    sh:message "신규 graph에는 deprecated TransferableDataset·TransferDistribution을 사용하지 않는다. dcat:Dataset·dcat:Distribution과 별도 DataspaceOfferingMetadata로 이관한다."@ko,
        "New graphs must not use deprecated TransferableDataset or TransferDistribution; migrate to DCAT resources and separate DataspaceOfferingMetadata."@en .
