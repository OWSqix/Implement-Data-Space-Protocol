{
  "@graph": [
    {
      "@id": "_:n3-1",
      "@type": [
        "http://xmlns.com/foaf/0.1/Agent"
      ],
      "http://purl.org/dc/terms/type": [
        {
          "@id": "https://data.molit.go.kr/candidate/concept/agent-type/unverified-publisher"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en",
          "@value": "The organization identifier and publishing authority await operating-authority approval. This blank node is not a Provider authority or an authoritative organization IRI."
        },
        {
          "@language": "ko",
          "@value": "기관 식별자와 발행권한은 운영기관 승인을 기다린다. 이 blank node를 Provider authority 또는 권위 기관 IRI로 사용하지 않는다."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ],
      "http://xmlns.com/foaf/0.1/name": [
        {
          "@language": "en",
          "@value": "Candidate MOLIT publishing agent"
        },
        {
          "@language": "ko",
          "@value": "국토교통부 발행주체 후보"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/candidate/concept/agent-type/unverified-publisher",
      "@type": [
        "http://www.w3.org/2004/02/skos/core#Concept"
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A publisher type used only by name on candidate artifacts where the operating authority has not yet approved an organization identifier or publishing authority."
        },
        {
          "@language": "ko",
          "@value": "후보 artifact에 이름으로만 표시했으며 기관 식별자와 발행권한을 운영기관이 아직 승인하지 않은 발행주체 유형."
        }
      ],
      "http://www.w3.org/2004/02/skos/core#notation": [
        {
          "@value": "unverified-publisher"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#prefLabel": [
        {
          "@language": "en",
          "@value": "Unverified candidate publisher"
        },
        {
          "@language": "ko",
          "@value": "미승인 발행주체 후보"
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap",
      "@type": [
        "http://www.w3.org/2002/07/owl#Ontology"
      ],
      "http://purl.org/dc/terms/description": [
        {
          "@language": "en",
          "@value": "Defines the minimum MOLIT catalogue semantics not supplied by DCAT 3 and DCAT-AP 3.0.1. This candidate ontology does not by itself prove institutional approval, provider authority or transfer availability."
        },
        {
          "@language": "ko",
          "@value": "DCAT 3와 DCAT-AP 3.0.1에 없는 국토교통 카탈로그 의미를 최소 범위로 정의한다. 이 후보 온톨로지는 기관 승인, 제공 권한 또는 전송 가능성을 스스로 증명하지 않는다."
        }
      ],
      "http://purl.org/dc/terms/issued": [
        {
          "@type": "http://www.w3.org/2001/XMLSchema#date",
          "@value": "2026-07-13"
        }
      ],
      "http://purl.org/dc/terms/modified": [
        {
          "@type": "http://www.w3.org/2001/XMLSchema#date",
          "@value": "2026-07-13"
        }
      ],
      "http://purl.org/dc/terms/publisher": [
        {
          "@id": "_:n3-1"
        }
      ],
      "http://purl.org/dc/terms/title": [
        {
          "@language": "en",
          "@value": "MOLIT data catalogue extension ontology"
        },
        {
          "@language": "ko",
          "@value": "국토교통 데이터 카탈로그 확장 온톨로지"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en",
          "@value": "Release Candidate. Namespace publication, local-artifact licensing and owner approval remain pending."
        }
      ],
      "http://www.w3.org/2002/07/owl#versionIRI": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap/1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap#DataspaceOfferingMetadata",
      "@type": [
        "http://www.w3.org/2002/07/owl#Class"
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en",
          "@value": "Dataspace offering metadata"
        },
        {
          "@language": "ko",
          "@value": "데이터 스페이스 제공 메타데이터"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
        {
          "@id": "http://www.w3.org/ns/dcat#Resource"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A discovery information object describing an intention to offer a dataset, its readiness and references to qualification evidence. It is not itself a DSP Offer, Agreement or operational approval."
        },
        {
          "@language": "ko",
          "@value": "데이터셋의 제공 의도, 준비상태와 자격 증거 참조를 기술하는 발견용 정보 객체. 이 객체는 DSP Offer, Agreement 또는 운영 승인 자체가 아니다."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap#NetworkDataset",
      "@type": [
        "http://www.w3.org/2002/07/owl#Class"
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en",
          "@value": "Transport network dataset"
        },
        {
          "@language": "ko",
          "@value": "교통망 데이터셋"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap#SpatialDataset"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A spatial dataset describing versioned transport-network elements such as roads, railways, stops, links or nodes."
        },
        {
          "@language": "ko",
          "@value": "도로, 철도, 정류장, 링크 또는 노드와 같이 판이 바뀔 수 있는 교통망 요소를 기술하는 공간 데이터셋."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap#NetworkReference",
      "@type": [
        "http://www.w3.org/2002/07/owl#Class"
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en",
          "@value": "Network reference"
        },
        {
          "@language": "ko",
          "@value": "교통망 참조"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A reference object preserving issuing authority, network identifier, edition, element types, snapshot checksum and lifecycle as one resolution unit."
        },
        {
          "@language": "ko",
          "@value": "발급기관, 망 식별자, 판, 요소 유형, snapshot checksum과 생명주기를 한 판정 단위로 보존하는 참조 객체."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap#ObservationDataset",
      "@type": [
        "http://www.w3.org/2002/07/owl#Class"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en",
          "@value": "The class describes catalogue metadata for a dataset. It is not declared equivalent to a SOSA observation or observation collection."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en",
          "@value": "Observation dataset"
        },
        {
          "@language": "ko",
          "@value": "관측 데이터셋"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
        {
          "@id": "http://www.w3.org/ns/sosa/ObservationCollection"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
        {
          "@id": "http://www.w3.org/ns/dcat#Dataset"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A dataset providing time-dependent traffic-volume, speed or travel-time observations together with observed-property, subject-type, aggregation, missing-value and unit semantics; facility-status observations are outside RC.1."
        },
        {
          "@language": "ko",
          "@value": "교통량, 속도 또는 통행시간의 시계열 관측값을 제공하며 관측항목, 관측대상 유형, 집계, 결측 처리와 단위를 함께 기술하는 데이터셋. 시설 상태 관측은 RC.1 범위가 아니다."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap#QualityMappingStatement",
      "@type": [
        "http://www.w3.org/2002/07/owl#Class"
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en",
          "@value": "Quality mapping statement"
        },
        {
          "@language": "ko",
          "@value": "품질 매핑 명세"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
        {
          "@id": "http://www.w3.org/ns/prov#Entity"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A statement recording the relation, loss disposition and reversibility used when mapping a source quality element to a DQV metric."
        },
        {
          "@language": "ko",
          "@value": "원천 품질 요소를 DQV metric으로 옮길 때 적용한 관계, 손실 처리와 역변환 가능성을 기록하는 명세."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap#SpatialDataset",
      "@type": [
        "http://www.w3.org/2002/07/owl#Class"
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en",
          "@value": "Spatial dataset"
        },
        {
          "@language": "ko",
          "@value": "공간 데이터셋"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
        {
          "@id": "http://www.w3.org/ns/dcat#Dataset"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A dataset describing a spatial extent or geometry and the coordinate reference system needed to interpret it."
        },
        {
          "@language": "ko",
          "@value": "공간 범위 또는 지오메트리와 그 해석에 필요한 좌표참조체계를 기술하는 데이터셋."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap#TransferDistribution",
      "@type": [
        "http://www.w3.org/2002/07/owl#Class"
      ],
      "http://purl.org/dc/terms/isReplacedBy": [
        {
          "@id": "http://www.w3.org/ns/dcat#Distribution"
        },
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap#DataspaceOfferingMetadata"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en",
          "@value": "Transfer distribution description"
        },
        {
          "@language": "ko",
          "@value": "전송 배포 설명"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
        {
          "@id": "http://www.w3.org/ns/dcat#Distribution"
        }
      ],
      "http://www.w3.org/2002/07/owl#deprecated": [
        {
          "@type": "http://www.w3.org/2001/XMLSchema#boolean",
          "@value": "true"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#changeNote": [
        {
          "@language": "en",
          "@value": "From 1.0.0-rc.1, new metadata uses dcat:Distribution and records offering readiness separately on molit:DataspaceOfferingMetadata. This legacy type is retained only for migrating 0.1.0 graphs."
        },
        {
          "@language": "ko",
          "@value": "1.0.0-rc.1부터 신규 metadata에는 dcat:Distribution을 사용하고 제공 준비상태는 molit:DataspaceOfferingMetadata에서 분리한다. 기존 유형은 0.1.0 graph migration에만 보존한다."
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A catalogue distribution description for a file or fixed data representation intended for a contract procedure. Actual access approval and transient transfer addresses are decided separately by the operational layer."
        },
        {
          "@language": "ko",
          "@value": "계약 절차에서 사용할 수 있는 파일 또는 고정 데이터 표현의 카탈로그 배포 설명. 실제 접근 승인과 일시적인 전송 주소는 운영 계층에서 별도로 판정한다."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/deprecated"
        }
      ]
    },
    {
      "@id": "https://data.molit.go.kr/def/molit-dcat-ap#TransferableDataset",
      "@type": [
        "http://www.w3.org/2002/07/owl#Class"
      ],
      "http://purl.org/dc/terms/isReplacedBy": [
        {
          "@id": "http://www.w3.org/ns/dcat#Dataset"
        },
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap#DataspaceOfferingMetadata"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en",
          "@value": "Operational eligibility is decided outside the metadata graph by an approved authority registry and runtime controls."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
        {
          "@id": "https://data.molit.go.kr/def/molit-dcat-ap"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en",
          "@value": "Dataset with a transfer description"
        },
        {
          "@language": "ko",
          "@value": "전송 설명이 있는 데이터셋"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
        {
          "@id": "http://www.w3.org/ns/dcat#Dataset"
        }
      ],
      "http://www.w3.org/2002/07/owl#deprecated": [
        {
          "@type": "http://www.w3.org/2001/XMLSchema#boolean",
          "@value": "true"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#changeNote": [
        {
          "@language": "en",
          "@value": "From 1.0.0-rc.1, new metadata uses dcat:Dataset with a separate molit:DataspaceOfferingMetadata resource. This legacy type is retained only for reading and migrating 0.1.0 graphs."
        },
        {
          "@language": "ko",
          "@value": "1.0.0-rc.1부터 신규 metadata에는 dcat:Dataset과 별도 molit:DataspaceOfferingMetadata를 사용한다. 기존 유형은 0.1.0 graph 읽기와 migration에만 보존한다."
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A dataset with one or more distribution descriptions intended for contract or transfer procedures. Declaring this type alone does not assert current provider authority, connector readiness or successful transfer."
        },
        {
          "@language": "ko",
          "@value": "계약 또는 전송 절차에서 사용할 배포 설명을 하나 이상 가진 데이터셋. 이 유형의 선언만으로 현재 제공 권한, Connector 준비 상태 또는 전송 성공을 주장하지 않는다."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/deprecated"
        }
      ]
