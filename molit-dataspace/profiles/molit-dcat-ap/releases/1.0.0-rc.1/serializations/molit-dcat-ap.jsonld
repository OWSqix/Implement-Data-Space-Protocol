        {
          "@id": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "http://www.w3.org/2002/07/owl#versionInfo": [
        {
          "@value": "1.0.0-rc.1"
        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "A human-reviewable statement explaining source semantics not preserved by the target representation and any reverse-mapping conditions."
        },
        {
          "@language": "ko",
          "@value": "대상 표현에서 보존되지 않는 원천 의미와 역변환 조건을 사람이 검토할 수 있도록 설명한 문장."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
