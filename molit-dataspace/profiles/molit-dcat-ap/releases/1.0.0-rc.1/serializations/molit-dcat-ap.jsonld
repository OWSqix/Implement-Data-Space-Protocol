        }
      ],
      "http://www.w3.org/2004/02/skos/core#definition": [
        {
          "@language": "en",
          "@value": "Links a quality measurement to a separate mapping statement recording the source quality element, target DQV metric, loss disposition and reverse-mapping conditions."
        },
        {
          "@language": "ko",
          "@value": "품질 측정값을 원천 품질 요소, 대상 DQV metric, 손실 처리와 역변환 조건을 기록한 별도 매핑 명세에 연결한다."
        }
      ],
      "http://www.w3.org/ns/adms#status": [
        {
          "@id": "https://data.molit.go.kr/id/concept/term-status/candidate"
        }
