@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix molit: <https://data.molit.go.kr/def/molit-dcat-ap#> .
@prefix molit-domain: <https://data.molit.go.kr/id/concept/domain/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.molit.go.kr/shape/molit-dcat-ap/0.1.0#CatalogShape>
    a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    molit:requirementId "MOLIT-CAT-001" ;
    molit:controlOwner "metadata-governance" ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:uniqueLang true ;
        sh:qualifiedValueShape [ sh:languageIn ( "ko" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "카탈로그에는 한국어 제목이 하나 이상 있어야 한다."@ko ;
        sh:message "A catalogue must have at least one Korean title."@en
    ], [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:uniqueLang true ;
        sh:qualifiedValueShape [ sh:languageIn ( "ko" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "카탈로그에는 한국어 설명이 하나 이상 있어야 한다."@ko
    ], [
        sh:path dct:publisher ;
        sh:class foaf:Agent ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "카탈로그 발행기관을 foaf:Agent IRI로 하나 지정해야 한다."@ko
    ], [
        sh:path dcat:dataset ;
        sh:class dcat:Dataset ;
        sh:minCount 1 ;
        sh:message "카탈로그에는 데이터셋이 하나 이상 있어야 한다."@ko
    ], [
        sh:path dcat:record ;
        sh:class dcat:CatalogRecord ;
        sh:minCount 1 ;
        sh:message "수집 이력을 추적할 CatalogRecord가 하나 이상 있어야 한다."@ko
    ], [
        sh:path dct:language ;
        sh:hasValue <http://publications.europa.eu/resource/authority/language/KOR> ;
        sh:minCount 1 ;
        sh:message "카탈로그 언어에는 EU 언어 코드 KOR을 포함해야 한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/0.1.0#CatalogRecordShape>
    a sh:NodeShape ;
    sh:targetClass dcat:CatalogRecord ;
    molit:requirementId "MOLIT-REC-001" ;
    molit:controlOwner "catalog-operations" ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:qualifiedValueShape [ sh:languageIn ( "ko" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "CatalogRecord에는 한국어 제목이 있어야 한다."@ko
    ], [
        sh:path dct:modified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
        sh:message "CatalogRecord 수정일은 xsd:date 또는 xsd:dateTime 값 하나여야 한다."@ko
    ], [
        sh:path foaf:primaryTopic ;
        sh:class dcat:Dataset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "CatalogRecord는 데이터셋 하나를 foaf:primaryTopic으로 가리켜야 한다."@ko
    ], [
        sh:path dct:language ;
        sh:hasValue <http://publications.europa.eu/resource/authority/language/KOR> ;
        sh:minCount 1 ;
        sh:message "CatalogRecord 언어에는 KOR을 포함해야 한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/0.1.0#DatasetShape>
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    molit:requirementId "MOLIT-DS-001" ;
    molit:controlOwner "dataset-steward" ;
    sh:property [
        sh:path [ sh:inversePath dcat:dataset ] ;
        sh:minCount 1 ;
        sh:class dcat:Catalog ;
        sh:message "게시 Dataset은 하나 이상의 dcat:Catalog에 포함돼야 한다."@ko
    ], [
        sh:path [ sh:inversePath foaf:primaryTopic ] ;
        sh:minCount 1 ;
        sh:class dcat:CatalogRecord ;
        sh:message "게시 Dataset에는 하나 이상의 dcat:CatalogRecord가 있어야 한다."@ko
    ], [
        sh:path dct:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:maxLength 500 ;
        sh:pattern "\\S" ;
        sh:message "데이터셋의 발급기관 범위 안에서 고유한 식별자 하나가 필요하다."@ko
    ], [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:uniqueLang true ;
        sh:qualifiedValueShape [ sh:languageIn ( "ko" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "데이터셋에는 한국어 제목이 하나 이상 있어야 한다."@ko
    ], [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:uniqueLang true ;
        sh:qualifiedValueShape [ sh:languageIn ( "ko" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "데이터셋에는 한국어 설명이 하나 이상 있어야 한다."@ko
    ], [
        sh:path dct:publisher ;
        sh:class foaf:Agent ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "데이터셋 발행기관을 foaf:Agent IRI 하나로 지정해야 한다."@ko
    ], [
        sh:path dcat:theme ;
        sh:minCount 2 ;
        sh:in (
            <http://publications.europa.eu/resource/authority/data-theme/TRAN>
            <http://publications.europa.eu/resource/authority/data-theme/REGI>
            molit-domain:land
            molit-domain:urban
            molit-domain:housing
            molit-domain:building
            molit-domain:real-estate
            molit-domain:construction
            molit-domain:transport
            molit-domain:road
            molit-domain:railway
            molit-domain:aviation
            molit-domain:logistics
            molit-domain:mobility
            molit-domain:transport-safety
            molit-domain:spatial-information
        ) ;
        sh:qualifiedValueShape [
            sh:in (
                <http://publications.europa.eu/resource/authority/data-theme/TRAN>
                <http://publications.europa.eu/resource/authority/data-theme/REGI>
            )
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "dcat:theme에는 DCAT-AP 데이터 주제 TRAN 또는 REGI를 포함해야 한다."@ko
    ], [
        sh:path dcat:theme ;
        sh:qualifiedValueShape [
            sh:nodeKind sh:IRI ;
            sh:in (
                molit-domain:land
                molit-domain:urban
                molit-domain:housing
                molit-domain:building
                molit-domain:real-estate
                molit-domain:construction
                molit-domain:transport
                molit-domain:road
                molit-domain:railway
                molit-domain:aviation
                molit-domain:logistics
                molit-domain:mobility
                molit-domain:transport-safety
                molit-domain:spatial-information
            )
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "dcat:theme에는 국토교통 주제 분류 IRI를 하나 이상 포함해야 한다."@ko
    ], [
        sh:path dct:accessRights ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            <http://publications.europa.eu/resource/authority/access-right/PUBLIC>
            <http://publications.europa.eu/resource/authority/access-right/RESTRICTED>
            <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC>
        ) ;
        sh:message "접근 권한은 승인된 dct:RightsStatement IRI 하나여야 한다."@ko
    ], [
        sh:path dct:issued ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
        sh:message "발행일은 xsd:date 또는 xsd:dateTime이어야 한다."@ko
    ], [
        sh:path dct:modified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
        sh:message "수정일은 xsd:date 또는 xsd:dateTime 값 하나여야 한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/0.1.0#TransferableDatasetShape>
    a sh:NodeShape ;
    sh:targetClass molit:TransferableDataset ;
    molit:requirementId "MOLIT-DS-TRANSFER-001" ;
    molit:controlOwner "data-delivery" ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue dcat:Dataset ;
        sh:message "확장 유형과 함께 dcat:Dataset 유형을 명시해야 한다."@ko
    ], [
        sh:path dcat:distribution ;
        sh:qualifiedValueShape [ sh:class molit:TransferDistribution ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "전송 가능한 데이터셋에는 molit:TransferDistribution 배포본이 하나 이상 있어야 한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/0.1.0#TransferDistributionShape>
    a sh:NodeShape ;
    sh:targetClass molit:TransferDistribution ;
    molit:requirementId "MOLIT-DIST-001" ;
    molit:controlOwner "data-delivery" ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue dcat:Distribution ;
        sh:message "확장 유형과 함께 dcat:Distribution 유형을 명시해야 한다."@ko
    ], [
        sh:path dcat:accessURL ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://" ;
        sh:message "배포본에는 사람이 확인하거나 시스템이 접근할 HTTPS accessURL이 있어야 한다."@ko
    ], [
        sh:path dct:format ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            <http://publications.europa.eu/resource/authority/file-type/CSV>
            <http://publications.europa.eu/resource/authority/file-type/JSON>
            <http://publications.europa.eu/resource/authority/file-type/JSON_LD>
            <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE>
            <http://publications.europa.eu/resource/authority/file-type/RDF_XML>
            <http://publications.europa.eu/resource/authority/file-type/XML>
            <http://publications.europa.eu/resource/authority/file-type/GML>
            <http://publications.europa.eu/resource/authority/file-type/GEOJSON>
            <http://publications.europa.eu/resource/authority/file-type/SHP>
        ) ;
        sh:message "배포 형식은 승인된 EU File Type IRI 하나여야 한다."@ko
    ], [
        sh:path dcat:mediaType ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://www[.]iana[.]org/assignments/media-types/" ;
        sh:message "mediaType은 IANA media type IRI를 사용해야 한다."@ko
    ], [
        sh:path dcatap:availability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            <http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE>
            <http://publications.europa.eu/resource/authority/planned-availability/EXPERIMENTAL>
            <http://publications.europa.eu/resource/authority/planned-availability/STABLE>
            <http://publications.europa.eu/resource/authority/planned-availability/TEMPORARY>
        ) ;
        sh:message "배포 가용성은 승인된 Distribution availability IRI여야 한다."@ko
    ] ;
    sh:or (
        [ sh:property [ sh:path dct:license ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
        [
            sh:property [
                sh:path dct:rights ;
                sh:minCount 1 ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:class dct:RightsStatement
            ]
        ]
    ) ;
    sh:message "배포본에는 라이선스 IRI 또는 dct:RightsStatement 권리 객체가 있어야 한다."@ko .

<https://data.molit.go.kr/shape/molit-dcat-ap/0.1.0#DataServiceShape>
    a sh:NodeShape ;
    sh:targetClass dcat:DataService ;
    molit:requirementId "MOLIT-SVC-001" ;
    molit:controlOwner "connector-operations" ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:qualifiedValueShape [ sh:languageIn ( "ko" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "DataService에는 한국어 제목이 있어야 한다."@ko
    ], [
        sh:path dcat:endpointURL ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://" ;
        sh:message "DataService에는 공개 가능한 endpointURL이 있어야 한다."@ko
    ], [
        sh:path dcat:servesDataset ;
        sh:minCount 1 ;
        sh:class dcat:Dataset ;
        sh:message "DataService가 제공하는 데이터셋을 하나 이상 연결해야 한다."@ko
    ] .

<https://data.molit.go.kr/shape/molit-dcat-ap/0.1.0#AgentShape>
    a sh:NodeShape ;
    sh:targetClass foaf:Agent ;
    molit:requirementId "MOLIT-AGENT-001" ;
    molit:controlOwner "participant-registry" ;
    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:qualifiedValueShape [ sh:languageIn ( "ko" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "기관에는 한국어 명칭이 있어야 한다."@ko
    ] .
