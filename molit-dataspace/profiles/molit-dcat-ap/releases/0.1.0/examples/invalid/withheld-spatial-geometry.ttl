@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://data.molit.go.kr/id/example-invalid/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geodcatap: <http://data.europa.eu/930/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix molit: <https://data.molit.go.kr/def/molit-dcat-ap#> .
@prefix quality: <https://data.molit.go.kr/id/concept/quality-status/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:dataset
    a dcat:Dataset,
        dcat:Resource,
        molit:SpatialDataset ;
    dct:identifier "invalid-withheld-geometry" ;
    dct:title "비공개 공간 범위 오류 예시"@ko ;
    dct:description "공간 공개 수준을 비공개로 지정했지만 bbox를 함께 게시했다."@ko ;
    dct:publisher ex:publisher ;
    dct:modified "2026-07-12"^^xsd:date ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    geodcatap:referenceSystem <http://www.opengis.net/def/crs/OGC/1.3/CRS84> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/TRAN>,
        <https://data.molit.go.kr/id/concept/domain/road> ;
    molit:qualityStatus quality:not-assessed ;
    molit:spatialDisclosureLevel <https://data.molit.go.kr/id/concept/spatial-disclosure-level/withheld> ;
    geo:hasBoundingBox ex:location .

ex:publisher
    a foaf:Agent ;
    foaf:name "시험 발행기관"@ko .

ex:location
    a geo:Geometry ;
    geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POLYGON((126 37,127 37,127 38,126 38,126 37))"^^geo:wktLiteral .

<http://www.opengis.net/def/crs/OGC/1.3/CRS84>
    a dct:Standard,
        skos:Concept .
