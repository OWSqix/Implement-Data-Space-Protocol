{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:molit:namespace-server-config:1",
  "title": "MOLIT namespace server configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowedHosts",
    "contractFile",
    "gracefulShutdownMs",
    "headerTimeoutMs",
    "keepAliveTimeoutMs",
    "listenHost",
    "maxArtifactBytes",
    "maxSnapshotBytes",
    "maxUrlLength",
    "port",
    "publicOrigin",
    "releaseRoot",
    "requestTimeoutMs"
  ],
  "properties": {
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 253 }
    },
    "contractFile": { "type": "string", "minLength": 1, "maxLength": 512 },
    "gracefulShutdownMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
    "headerTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
    "keepAliveTimeoutMs": { "type": "integer", "minimum": 0, "maximum": 120000 },
    "listenHost": { "type": "string", "minLength": 1, "maxLength": 253 },
    "maxArtifactBytes": { "type": "integer", "minimum": 1024, "maximum": 536870912 },
    "maxSnapshotBytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824 },
    "maxUrlLength": { "type": "integer", "minimum": 256, "maximum": 32768 },
    "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "publicOrigin": { "type": "string", "minLength": 9, "maxLength": 2048 },
    "releaseRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
  }
}
