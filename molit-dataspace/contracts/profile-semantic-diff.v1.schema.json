{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/profile-semantic-diff.v1.json",
  "title": "MOLIT profile semantic diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "from",
    "to",
    "profileModules",
    "requirements",
    "ontology",
    "controlledValues",
    "reviewedBreakingChanges"
  ],
  "properties": {
    "schemaVersion": { "const": "molit.profile-semantic-diff/1" },
    "from": { "$ref": "#/$defs/release" },
    "to": { "$ref": "#/$defs/release" },
    "profileModules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conformance", "validationPolicy"],
      "properties": {
        "conformance": { "$ref": "#/$defs/namedSetDiff" },
        "validationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "$ref": "#/$defs/stringArray" },
            "to": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    },
    "requirements": { "$ref": "#/$defs/requirementDiff" },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "changed", "deprecatedInTarget", "removed"],
      "properties": {
        "added": { "$ref": "#/$defs/iriArray" },
        "removed": { "$ref": "#/$defs/iriArray" },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["iri", "from", "to"],
            "properties": {
              "iri": { "type": "string", "format": "uri" },
              "from": { "$ref": "#/$defs/termState" },
              "to": { "$ref": "#/$defs/termState" }
            }
          }
        },
        "deprecatedInTarget": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["iri", "replacements"],
            "properties": {
              "iri": { "type": "string", "format": "uri" },
              "replacements": { "$ref": "#/$defs/iriArray" }
            }
          }
        }
      }
    },
    "controlledValues": { "$ref": "#/$defs/countDiff" },
    "reviewedBreakingChanges": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "migrationSection", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^BREAK-[A-Z0-9-]+$" },
          "migrationSection": { "type": "string", "pattern": "^MIGRATION\\.md#" },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "version"],
      "properties": {
        "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "iriArray": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "namedSetDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "from", "removed", "to"],
      "properties": {
        "added": { "$ref": "#/$defs/stringArray" },
        "from": { "$ref": "#/$defs/stringArray" },
        "removed": { "$ref": "#/$defs/stringArray" },
        "to": { "$ref": "#/$defs/stringArray" }
      }
    },
    "countDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "fromCount", "removed", "toCount"],
      "properties": {
        "added": { "$ref": "#/$defs/stringArray" },
        "fromCount": { "type": "integer", "minimum": 0 },
        "removed": { "$ref": "#/$defs/stringArray" },
        "toCount": { "type": "integer", "minimum": 0 }
      }
    },
    "requirementState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraintCount", "graphSha256", "shapeFiles"],
      "properties": {
        "constraintCount": { "type": "integer", "minimum": 1 },
        "graphSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "shapeFiles": { "$ref": "#/$defs/stringArray" }
      }
    },
    "requirementDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "changed", "fromCount", "removed", "toCount"],
      "properties": {
        "added": { "$ref": "#/$defs/stringArray" },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "requirementId", "to"],
            "properties": {
              "from": { "$ref": "#/$defs/requirementState" },
              "requirementId": { "type": "string", "minLength": 1 },
              "to": { "$ref": "#/$defs/requirementState" }
            }
          }
        },
        "fromCount": { "type": "integer", "minimum": 0 },
        "removed": { "$ref": "#/$defs/stringArray" },
        "toCount": { "type": "integer", "minimum": 0 }
      }
    },
    "termState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deprecated", "replacements", "types"],
      "properties": {
        "deprecated": { "type": "boolean" },
        "replacements": { "$ref": "#/$defs/iriArray" },
        "types": { "$ref": "#/$defs/iriArray" }
      }
    }
  }
}
