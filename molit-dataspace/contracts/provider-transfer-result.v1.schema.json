{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/provider-transfer-result.v1.json",
  "title": "Provisioner result",
  "type": "object",
  "additionalProperties": false,
  "required": ["providerPid", "agreementId", "provisioningKey", "resourceRefDigest", "requestDigest", "provisioningId", "dataAddress"],
  "properties": {
    "providerPid": { "type": "string", "minLength": 1, "maxLength": 512 },
    "agreementId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "provisioningKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resourceRefDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provisioningId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "dataAddress": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
      "additionalProperties": { "anyOf": [{ "type": "string", "maxLength": 8192 }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] }
    }
  }
}
