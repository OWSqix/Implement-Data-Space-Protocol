{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/controlled-vocabulary-registry.v1.json",
  "title": "MOLIT controlled-vocabulary lifecycle registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileVersion",
    "registryStatus",
    "asOf",
    "lifecycleSemantics",
    "categoryCounts",
    "registries",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "molit.controlled-vocabulary-registry/1"
    },
    "profileVersion": {
      "const": "1.0.0-rc.1"
    },
    "registryStatus": {
      "const": "candidate-pending-authority-approval"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "lifecycleSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validFrom", "nullValidTo", "nullReplacedBy"],
      "properties": {
        "validFrom": { "type": "string", "minLength": 1 },
        "nullValidTo": { "type": "string", "minLength": 1 },
        "nullReplacedBy": { "type": "string", "minLength": 1 }
      }
    },
    "categoryCounts": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "registries": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/registry" }
    },
    "entries": {
      "type": "array",
      "minItems": 80,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "authorities"],
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^vocabulary/.+\\.ttl$"
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iri", "source", "status"],
      "properties": {
        "iri": { "type": "string", "format": "uri" },
        "source": { "$ref": "#/$defs/source" },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "value"],
      "properties": {
        "language": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "iri",
        "notation",
        "preferredLabel",
        "replacedBy",
        "scheme",
        "source",
        "status",
        "validFrom",
        "validTo"
      ],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "iri": { "type": "string", "format": "uri" },
        "notation": { "type": "string", "minLength": 1 },
        "preferredLabel": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/label" }
        },
        "replacedBy": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "scheme": { "type": "string", "format": "uri" },
        "source": { "$ref": "#/$defs/source" },
        "status": { "type": "string", "minLength": 1 },
        "validFrom": { "type": "string", "format": "date" },
        "validTo": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    }
  }
}
