{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/content-negotiation-contract.v1.json",
  "title": "MOLIT profile content-negotiation deployment contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileVersion",
    "status",
    "namespaceStatus",
    "responseRules",
    "resources",
    "deploymentGate",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "molit.content-negotiation-contract/1"
    },
    "profileVersion": {
      "const": "1.0.0-rc.1"
    },
    "status": {
      "const": "candidate-deployment-contract"
    },
    "namespaceStatus": {
      "const": "proposed-not-yet-dereferenceable"
    },
    "responseRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsupportedAccept",
        "vary",
        "dynamicNetworkImports",
        "exactByteArtifacts"
      ],
      "properties": {
        "unsupportedAccept": {
          "const": 406
        },
        "vary": {
          "const": ["Accept"]
        },
        "dynamicNetworkImports": {
          "const": false
        },
        "exactByteArtifacts": {
          "const": true
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iris", "representations"],
        "properties": {
          "iris": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "representations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["application/ld+json", "text/html", "text/turtle"],
            "properties": {
              "application/ld+json": {"type": "string", "minLength": 1},
              "text/html": {"type": "string", "minLength": 1},
              "text/turtle": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "deploymentGate": {
      "const": "RA-NAMESPACE"
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
