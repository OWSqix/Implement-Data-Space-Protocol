{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molit.example/contracts/identity-runtime-config.v1.schema.json",
  "title": "MOLIT operational identity runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "network", "policy"],
  "properties": {
    "schemaVersion": { "const": "molit.identity-runtime-config/1" },
    "mode": { "enum": ["oidc-jwt", "rfc7662-introspection"] },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedOrigins", "allowInsecureLoopback", "timeoutMs", "maxResponseBytes"],
      "properties": {
        "allowedOrigins": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "allowInsecureLoopback": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 2097152 }
      }
    },
    "policy": { "$ref": "#/$defs/policy" },
    "oidcJwt": { "$ref": "#/$defs/oidcJwt" },
    "introspection": { "$ref": "#/$defs/introspection" }
  },
  "allOf": [
    { "if": { "properties": { "mode": { "const": "oidc-jwt" } } }, "then": { "required": ["oidcJwt"], "properties": { "oidcJwt": { "$ref": "#/$defs/oidcJwt" }, "introspection": false } } },
    { "if": { "properties": { "mode": { "const": "rfc7662-introspection" } } }, "then": { "required": ["introspection"], "properties": { "introspection": { "$ref": "#/$defs/introspection" }, "oidcJwt": false } } }
  ],
  "$defs": {
    "claimPath": { "type": "string", "pattern": "^[A-Za-z0-9_#-]+(?:\\.[A-Za-z0-9_#-]+)*$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audiences", "clientIdClaim", "tokenIdClaim", "actorTypeClaim", "rolesClaim", "tenantIdsClaim", "actorTypes", "allowedClientIds", "allowedRoles", "clockSkewSeconds", "maxTokenLifetimeSeconds", "humanMfa"],
      "properties": {
        "issuer": { "type": "string", "format": "uri", "maxLength": 2048 },
        "audiences": { "$ref": "#/$defs/nonEmptyStrings" },
        "clientIdClaim": { "$ref": "#/$defs/claimPath" },
        "tokenIdClaim": { "$ref": "#/$defs/claimPath" },
        "actorTypeClaim": { "$ref": "#/$defs/claimPath" },
        "rolesClaim": { "$ref": "#/$defs/claimPath" },
        "tenantIdsClaim": { "$ref": "#/$defs/claimPath" },
        "actorTypes": { "type": "object", "additionalProperties": false, "required": ["human", "service"], "properties": { "human": { "type": "string", "minLength": 1 }, "service": { "type": "string", "minLength": 1 } } },
        "allowedClientIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "allowedRoles": { "$ref": "#/$defs/nonEmptyStrings" },
        "clockSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "maxTokenLifetimeSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "humanMfa": { "type": "object", "additionalProperties": false, "required": ["acceptedAcrValues", "requiredAmrAny"], "properties": { "acceptedAcrValues": { "$ref": "#/$defs/nonEmptyStrings" }, "requiredAmrAny": { "$ref": "#/$defs/nonEmptyStrings" } } }
      }
    },
    "oidcJwt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discoveryUrl", "allowedAlgorithms", "allowedTokenTypes", "cacheTtlMs", "rotationOverlapMs", "minimumRefreshIntervalMs", "maxKeys"],
      "properties": {
        "discoveryUrl": { "type": "string", "format": "uri" },
        "allowedAlgorithms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["RS256", "PS256", "ES256"] } },
        "allowedTokenTypes": { "$ref": "#/$defs/nonEmptyStrings" },
        "cacheTtlMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "rotationOverlapMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "minimumRefreshIntervalMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "maxKeys": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "introspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introspectionUrl", "clientId", "clientSecretRef", "readinessMaxAgeMs"],
      "properties": {
        "introspectionUrl": { "type": "string", "format": "uri" },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "clientSecretRef": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "readinessMaxAgeMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    }
  }
}
