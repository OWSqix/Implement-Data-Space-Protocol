{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/contracts/supply-chain-runtime-image-inventory.v1.schema.json",
  "title": "MOLIT production runtime image inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "admissionPolicy",
    "vulnerabilityExceptionPolicy",
    "forbiddenDockerTargets",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "molit.supply-chain-runtime-image-inventory/1" },
    "admissionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "name", "predicateType", "managedNamespaceLabel"],
      "properties": {
        "apiVersion": { "const": "policies.kyverno.io/v1" },
        "kind": { "const": "ImageValidatingPolicy" },
        "name": { "const": "molit-verify-release-images" },
        "predicateType": { "const": "https://data.molit.go.kr/attestations/release-bundle/v1" },
        "managedNamespaceLabel": { "const": "supply-chain.data.molit.go.kr/enforcement=required" }
      }
    },
    "vulnerabilityExceptionPolicy": { "const": "no-waiver" },
    "forbiddenDockerTargets": {
      "type": "array",
      "const": ["smoke-control-plane", "smoke-data-plane"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/artifact" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "runtimeClass": { "const": "caas-control-plane" } }, "required": ["runtimeClass"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "runtimeClass": { "const": "dsaas-control-plane" } }, "required": ["runtimeClass"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "runtimeClass": { "const": "fencing-webhook" } }, "required": ["runtimeClass"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "runtimeClass": { "const": "edc-control-plane" } }, "required": ["runtimeClass"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "runtimeClass": { "const": "edc-data-plane" } }, "required": ["runtimeClass"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "runtimeClass": { "const": "schema-migration" } }, "required": ["runtimeClass"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "runtimeClass": { "const": "postgres-operand" } }, "required": ["runtimeClass"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "runtimeClass": { "const": "otel-collector" } }, "required": ["runtimeClass"] }, "minContains": 1, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "digestImage": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "deploymentUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "imageBinding"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
        "path": { "type": "string", "pattern": "^(deploy|src)/[^\\\\]+$" },
        "imageBinding": { "type": "string", "minLength": 3, "maxLength": 160 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "runtimeClass",
        "productionEligible",
        "provenanceMode",
        "releaseCommand",
        "admissionRequired",
        "deploymentUses",
        "blockers"
      ],
      "properties": {
        "service": {
          "enum": [
            "caas",
            "dsaas",
            "fencing-webhook",
            "edc-control-plane",
            "edc-data-plane",
            "edc-schema-migration",
            "postgres-operand",
            "otel-collector"
          ]
        },
        "runtimeClass": {
          "enum": [
            "caas-control-plane",
            "dsaas-control-plane",
            "fencing-webhook",
            "edc-control-plane",
            "edc-data-plane",
            "schema-migration",
            "postgres-operand",
            "otel-collector"
          ]
        },
        "productionEligible": { "type": "boolean" },
        "provenanceMode": { "enum": ["source-build", "external-adoption"] },
        "upstreamImage": { "$ref": "#/$defs/digestImage" },
        "releaseCommand": { "type": "string", "minLength": 10, "maxLength": 512 },
        "admissionRequired": { "const": true },
        "deploymentUses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deploymentUse" }
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,95}$" }
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "service": { "const": "caas" } }, "required": ["service"] },
          "then": { "type": "object", "properties": { "runtimeClass": { "const": "caas-control-plane" } } }
        },
        {
          "if": { "type": "object", "properties": { "service": { "const": "dsaas" } }, "required": ["service"] },
          "then": { "type": "object", "properties": { "runtimeClass": { "const": "dsaas-control-plane" } } }
        },
        {
          "if": { "type": "object", "properties": { "service": { "const": "fencing-webhook" } }, "required": ["service"] },
          "then": { "type": "object", "properties": { "runtimeClass": { "const": "fencing-webhook" } } }
        },
        {
          "if": { "type": "object", "properties": { "service": { "const": "edc-control-plane" } }, "required": ["service"] },
          "then": { "type": "object", "properties": { "runtimeClass": { "const": "edc-control-plane" } } }
        },
        {
          "if": { "type": "object", "properties": { "service": { "const": "edc-data-plane" } }, "required": ["service"] },
          "then": { "type": "object", "properties": { "runtimeClass": { "const": "edc-data-plane" } } }
        },
        {
          "if": { "type": "object", "properties": { "service": { "const": "edc-schema-migration" } }, "required": ["service"] },
          "then": { "type": "object", "properties": { "runtimeClass": { "const": "schema-migration" } } }
        },
        {
          "if": { "type": "object", "properties": { "service": { "const": "postgres-operand" } }, "required": ["service"] },
          "then": { "type": "object", "properties": { "runtimeClass": { "const": "postgres-operand" } } }
        },
        {
          "if": { "type": "object", "properties": { "service": { "const": "otel-collector" } }, "required": ["service"] },
          "then": { "type": "object", "properties": { "runtimeClass": { "const": "otel-collector" } } }
        },
        {
          "if": { "type": "object", "properties": { "provenanceMode": { "const": "external-adoption" } }, "required": ["provenanceMode"] },
          "then": {
            "type": "object",
            "required": ["upstreamImage"],
            "properties": {
              "upstreamImage": { "$ref": "#/$defs/digestImage" },
              "service": { "enum": ["postgres-operand", "otel-collector"] },
              "runtimeClass": { "enum": ["postgres-operand", "otel-collector"] },
              "releaseCommand": { "type": "string", "pattern": "^deploy/images/adopt-sign-verify\\.ps1 " }
            }
          },
          "else": {
            "type": "object",
            "not": { "type": "object", "properties": { "upstreamImage": {} }, "required": ["upstreamImage"] },
            "properties": {
              "releaseCommand": { "type": "string", "pattern": "^deploy/images/build-sign-verify\\.ps1 " }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "runtimeClass": { "enum": ["edc-control-plane", "edc-data-plane"] } },
            "required": ["runtimeClass"]
          },
          "then": {
            "type": "object",
            "properties": {
              "productionEligible": { "const": false },
              "blockers": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "productionEligible": { "const": true },
              "blockers": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
