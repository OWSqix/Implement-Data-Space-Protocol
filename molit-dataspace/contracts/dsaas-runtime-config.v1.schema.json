{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/dsaas-runtime-config.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "listenHost",
    "port",
    "publicOrigin",
    "allowedHosts",
    "stateStore",
    "serviceRegistryPath",
    "serviceRegistrySha256",
    "serviceRegistryMaxAgeSeconds",
    "approvalDecisionRegistryPath",
    "approvalDecisionRegistrySha256",
    "approvalDecisionRegistryMaxAgeSeconds",
    "approvedMetadataProfiles",
    "approvedGovernanceBundles",
    "connectorPlanIds",
    "allowedNamespaceOrigins",
    "auth",
    "caas",
    "reconcileScheduler",
    "network",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "const": "molit.dsaas-runtime-config/1" },
    "environment": { "enum": ["production", "development", "test"] },
    "listenHost": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "publicOrigin": { "type": "string", "format": "uri" },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+(?::[0-9]{1,5})?$" }
    },
    "stateStore": { "$ref": "#/$defs/stateStore" },
    "serviceRegistryPath": { "type": "string", "minLength": 1 },
    "serviceRegistrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "serviceRegistryMaxAgeSeconds": { "type": "integer", "minimum": 60, "maximum": 2592000 },
    "approvalDecisionRegistryPath": { "type": "string", "minLength": 1 },
    "approvalDecisionRegistrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvalDecisionRegistryMaxAgeSeconds": { "type": "integer", "minimum": 60, "maximum": 2592000 },
    "approvedMetadataProfiles": { "$ref": "#/$defs/artifacts" },
    "approvedGovernanceBundles": { "$ref": "#/$defs/artifacts" },
    "connectorPlanIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }
    },
    "allowedNamespaceOrigins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://[^/]+$" }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "introspectionUrl", "clientIdEnv", "clientSecretEnv", "issuer", "audience", "clientIdClaim", "keyIdClaim", "rolesClaim", "dataspaceIdsClaim"],
      "properties": {
        "type": { "const": "oauth2-introspection" },
        "introspectionUrl": { "type": "string", "format": "uri" },
        "clientIdEnv": { "$ref": "#/$defs/env" },
        "clientSecretEnv": { "$ref": "#/$defs/env" },
        "issuer": { "type": "string", "format": "uri" },
        "audience": { "type": "string", "minLength": 1, "maxLength": 256 },
        "clientIdClaim": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "keyIdClaim": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "rolesClaim": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "dataspaceIdsClaim": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
      }
    },
    "caas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "ensurePath", "supportsIdempotencyKey", "auth"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "ensurePath": { "type": "string", "pattern": "^/", "maxLength": 512 },
        "supportsIdempotencyKey": { "const": true },
        "auth": { "$ref": "#/$defs/outboundAuth" }
      }
    },
    "reconcileScheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalMs", "maxDataspacesPerTick", "readinessMaxLagMs", "caasRetryBaseMs", "caasRetryMaxMs"],
      "properties": {
        "intervalMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "maxDataspacesPerTick": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "readinessMaxLagMs": { "type": "integer", "minimum": 1000, "maximum": 172800000 },
        "caasRetryBaseMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "caasRetryMaxMs": { "type": "integer", "minimum": 1000, "maximum": 604800000 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedOrigins", "privateOrigins", "allowHttp", "allowPrivate", "timeoutMs", "maxResponseBytes", "retries"],
      "properties": {
        "allowedOrigins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "privateOrigins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "allowHttp": { "type": "boolean" },
        "allowPrivate": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRequestBytes", "maxStateBytes", "maxDataspaces", "maxParticipantsPerDataspace", "maxIdempotencyRecords", "maxReconcileSupersessions", "headerTimeoutMs", "requestTimeoutMs", "keepAliveTimeoutMs", "gracefulShutdownMs"],
      "properties": {
        "maxRequestBytes": { "type": "integer", "minimum": 1024, "maximum": 4194304 },
        "maxStateBytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
        "maxDataspaces": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxParticipantsPerDataspace": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxIdempotencyRecords": { "type": "integer", "minimum": 100, "maximum": 10000000 },
        "maxReconcileSupersessions": { "type": "integer", "minimum": 1, "maximum": 64 },
        "headerTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "keepAliveTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "gracefulShutdownMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
      }
    }
  },
  "$defs": {
    "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
    "stateStore": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "file" },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "connectionStringEnv",
            "holderIdEnv",
            "applicationName",
            "tls",
            "maxPoolSize",
            "maxLeasePoolSize",
            "connectionTimeoutMs",
            "idleTimeoutMs",
            "statementTimeoutMs",
            "lockTimeoutMs"
          ],
          "properties": {
            "type": { "const": "postgres" },
            "connectionStringEnv": { "$ref": "#/$defs/env" },
            "holderIdEnv": { "$ref": "#/$defs/env" },
            "applicationName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,62}$" },
            "tls": { "$ref": "#/$defs/postgresTls" },
            "maxPoolSize": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxLeasePoolSize": { "type": "integer", "minimum": 1, "maximum": 100 },
            "connectionTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
            "idleTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
            "statementTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
            "lockTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 }
          }
        }
      ]
    },
    "postgresTls": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "disable" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "caEnv"],
          "properties": {
            "mode": { "const": "verify-full" },
            "caEnv": { "$ref": "#/$defs/env" },
            "certEnv": { "$ref": "#/$defs/env" },
            "keyEnv": { "$ref": "#/$defs/env" }
          },
          "dependentRequired": {
            "certEnv": ["keyEnv"],
            "keyEnv": ["certEnv"]
          }
        }
      ]
    },
    "outboundAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "env"],
      "properties": {
        "type": { "enum": ["bearer", "api-key"] },
        "env": { "$ref": "#/$defs/env" },
        "header": { "enum": ["api-key", "ocp-apim-subscription-key", "x-api-key", "x-auth-token"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "bearer" } }, "required": ["type"] }, "then": { "properties": { "header": false } } }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iri", "version", "sha256"],
      "properties": {
        "iri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    }
  }
}
