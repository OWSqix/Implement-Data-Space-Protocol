{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/caas-tenant-registration.v1.json",
  "title": "CaaS tenant registration request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "organizationId", "displayName", "adapterId", "runtimeProfileRef", "apiAccessSecretRef", "apiPrincipalId", "apiClientId", "apiKeyId", "deploymentSecretRefs"],
  "properties": {
    "schemaVersion": { "const": "molit.caas-tenant-registration/1" },
    "tenantId": { "$ref": "#/$defs/tenantId" },
    "organizationId": { "$ref": "#/$defs/id" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "adapterId": { "$ref": "#/$defs/id" },
    "runtimeProfileRef": { "$ref": "#/$defs/id" },
    "apiAccessSecretRef": { "type": "string", "pattern": "^env://[A-Z_][A-Z0-9_]*$", "maxLength": 256 },
    "apiPrincipalId": { "$ref": "#/$defs/authId" },
    "apiClientId": { "$ref": "#/$defs/authId" },
    "apiKeyId": { "$ref": "#/$defs/authId" },
    "deploymentSecretRefs": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9._-]{0,63}$" },
      "additionalProperties": { "type": "string", "pattern": "^(?:env://[A-Z_][A-Z0-9_]*|vault://[A-Za-z0-9][A-Za-z0-9._/-]{0,239})$", "maxLength": 256 }
    }
  },
  "$defs": {
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "authId": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f\\s]+$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
  }
}
