{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molit-dataspace.example.invalid/schemas/connector-registration-candidate.v1.schema.json",
  "title": "Connector registration review candidate v1",
  "description": "Internal synthetic review object. This is not a DSP wire message and automatic dispatch is forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "automaticDispatchAllowed",
    "routing",
    "source",
    "catalogProjection",
    "registration"
  ],
  "properties": {
    "schemaVersion": {
      "const": "molit.connector-registration-candidate/1"
    },
    "automaticDispatchAllowed": {
      "const": false
    },
    "routing": {
      "const": "internal-review-only"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "catalogProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileStatus", "dspVersion", "@context", "@graph"],
      "properties": {
        "profileStatus": {
          "const": "project-draft-not-dsp-wire-message"
        },
        "dspVersion": {
          "const": "2025-1"
        },
        "@context": {
          "type": "object"
        },
        "@graph": {
          "type": "array",
          "minItems": 3,
          "maxItems": 52,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "registration": {
      "$ref": "#/$defs/registration"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s?#@]+$"
    },
    "evidenceIds": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemId", "recordId"],
      "properties": {
        "systemId": {
          "$ref": "#/$defs/identifier"
        },
        "recordId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "providerAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidenceIds"],
      "properties": {
        "kind": {
          "enum": ["owner", "delegate", "agent"]
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "governanceApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "approvalEntryDigest",
        "approvedAt",
        "approverId",
        "catalogVisibility",
        "evidenceIds",
        "offeringDecision",
        "registryId",
        "status",
        "syntheticOnly",
        "validUntil"
      ],
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/identifier"
        },
        "approvalEntryDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approverId": {
          "$ref": "#/$defs/identifier"
        },
        "catalogVisibility": {
          "const": "public"
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "offeringDecision": {
          "const": "approved"
        },
        "registryId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "verified-synthetic"
        },
        "syntheticOnly": {
          "const": true
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distributionId",
        "format",
        "transferFormat",
        "accessProfile",
        "sourceBindingRef",
        "lifecycleMode",
        "evidenceIds"
      ],
      "properties": {
        "distributionId": {
          "type": "string",
          "pattern": "^urn:"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "transferFormat": {
          "type": "string",
          "pattern": "^(transfer:|urn:)"
        },
        "accessProfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sourceBindingRef": {
          "type": "string",
          "pattern": "^(binding://[A-Za-z0-9][A-Za-z0-9._~-]*(/[A-Za-z0-9][A-Za-z0-9._~-]*)+|urn:[A-Za-z0-9][A-Za-z0-9._~-]*(:[A-Za-z0-9][A-Za-z0-9._~-]*)+)$"
        },
        "lifecycleMode": {
          "enum": ["none", "manual", "token", "entitlement", "subscription", "job"]
        },
        "revocationMode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycleMode": {
                "not": {
                  "const": "none"
                }
              }
            }
          },
          "then": {
            "properties": {
              "revocationMode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": ["revocationMode"]
          }
        }
      ]
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "providerParticipantId",
        "providerParticipantUrn",
        "connectorOperatorId",
        "deliveryOperatorId",
        "contractingPartyId",
        "originDataHolderId",
        "providerAuthority",
        "governanceApproval",
        "policyRef",
        "bindings"
      ],
      "properties": {
        "datasetId": {
          "type": "string",
          "pattern": "^urn:"
        },
        "providerParticipantId": {
          "$ref": "#/$defs/identifier"
        },
        "providerParticipantUrn": {
          "type": "string",
          "pattern": "^urn:"
        },
        "connectorOperatorId": {
          "$ref": "#/$defs/identifier"
        },
        "deliveryOperatorId": {
          "$ref": "#/$defs/identifier"
        },
        "contractingPartyId": {
          "$ref": "#/$defs/identifier"
        },
        "originDataHolderId": {
          "$ref": "#/$defs/identifier"
        },
        "providerAuthority": {
          "$ref": "#/$defs/providerAuthority"
        },
        "governanceApproval": {
          "$ref": "#/$defs/governanceApproval"
        },
        "policyRef": {
          "type": "string",
          "pattern": "^(policy:|urn:)"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    }
  }
}
