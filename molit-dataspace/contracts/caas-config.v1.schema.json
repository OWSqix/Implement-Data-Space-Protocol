{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/caas-config.v1.json",
  "title": "MOLIT CaaS control-plane configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "listen", "statePath", "adminSecretRef", "adminPrincipalId", "adminClientId", "adminKeyId", "controller", "identityPolicy", "limits", "connectorPlans", "provisioners"],
  "properties": {
    "schemaVersion": { "const": "molit.caas-config/1" },
    "environment": { "enum": ["production", "development", "test"] },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 255 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "statePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "adminSecretRef": { "$ref": "#/$defs/envSecretRef" },
    "adminPrincipalId": { "$ref": "#/$defs/authId" },
    "adminClientId": { "$ref": "#/$defs/authId" },
    "adminKeyId": { "$ref": "#/$defs/authId" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretRef", "principalId", "clientId", "keyId", "allowedDataspaceIds", "allowedTenantIds", "allowedConnectorPlanIds"],
      "properties": {
        "secretRef": { "$ref": "#/$defs/envSecretRef" },
        "principalId": { "$ref": "#/$defs/authId" },
        "clientId": { "$ref": "#/$defs/authId" },
        "keyId": { "$ref": "#/$defs/authId" },
        "allowedDataspaceIds": { "$ref": "#/$defs/idList" },
        "allowedTenantIds": { "$ref": "#/$defs/idList" },
        "allowedConnectorPlanIds": { "$ref": "#/$defs/idList" }
      }
    },
    "identityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantIdTemplate", "namespaceTemplate", "endpointTemplate"],
      "properties": {
        "participantIdTemplate": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "namespaceTemplate": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "endpointTemplate": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRequestBytes", "maxStateBytes", "maxAuditEvents", "maxAuditResponseEvents", "requestTimeoutMs"],
      "properties": {
        "maxRequestBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "maxStateBytes": { "type": "integer", "minimum": 65536, "maximum": 268435456 },
        "maxAuditEvents": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "maxAuditResponseEvents": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 }
      }
    },
    "connectorPlans": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{2,62}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapterId", "runtimeProfileRef", "deploymentMode", "metadataProfile", "protocolProfile", "requiredDeploymentSecretNames"],
        "properties": {
          "adapterId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "runtimeProfileRef": { "type": "string", "minLength": 1, "maxLength": 512 },
          "deploymentMode": { "enum": ["isolated", "virtualized"] },
          "metadataProfile": { "$ref": "#/$defs/versionedArtifact" },
          "protocolProfile": { "$ref": "#/$defs/protocolProfile" },
          "requiredDeploymentSecretNames": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 32,
            "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9._-]{0,63}$" }
          }
        }
      }
    },
    "provisioners": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{2,62}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "manifestDirectory"],
        "properties": {
          "type": { "const": "dry-run-manifest" },
          "manifestDirectory": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  },
  "$defs": {
    "envSecretRef": { "type": "string", "pattern": "^env://[A-Z_][A-Z0-9_]*$", "maxLength": 256 },
    "authId": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f\\s]+$" },
    "idList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }
    },
    "versionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iri", "version", "sha256"],
      "properties": {
        "iri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "protocolProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dspVersion", "specification", "identityMode"],
      "properties": {
        "dspVersion": { "const": "2025-1" },
        "specification": { "const": "https://eclipse-dataspace-protocol-base.github.io/DataspaceProtocol/2025-1-err1/" },
        "identityMode": { "enum": ["dcp", "test-token"] }
      }
    }
  }
}
