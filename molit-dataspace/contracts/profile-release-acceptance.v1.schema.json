{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/profile-release-acceptance.v1.json",
  "title": "MOLIT profile release acceptance register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileVersion",
    "asOf",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "molit.profile-release-acceptance/1"
    },
    "profileVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "scope",
          "severity",
          "status",
          "blocksCandidate",
          "blocksRecommendation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RA-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "profile-core",
              "institutional",
              "interoperability-pack"
            ]
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "status": {
            "enum": [
              "fixed",
              "open",
              "blocked-external-evidence",
              "deferred-nonblocking"
            ]
          },
          "blocksCandidate": {
            "type": "boolean"
          },
          "blocksRecommendation": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "repository-file",
                    "command",
                    "external-action",
                    "git-control",
                    "requirement-coverage"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
