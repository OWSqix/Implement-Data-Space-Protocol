{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/contracts/usage-meter-event.v1.schema.json",
  "title": "MOLIT tenant usage meter event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "tenantId", "eventId", "meterName", "purpose", "quantity", "unit", "occurredAt", "traceId", "correlationId", "sourceEventId", "sourceEventDigest", "dimensions"],
  "properties": {
    "schemaVersion": { "const": "molit.usage-meter-event/1" },
    "component": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "tenantId": { "type": "string", "minLength": 3, "maxLength": 128 },
    "eventId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "meterName": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$" },
    "purpose": { "enum": ["operational-non-billable", "billing-candidate"] },
    "quantity": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,20})(?:\\.[0-9]{1,9})?$" },
    "unit": { "type": "string", "pattern": "^(?:[A-Za-z][A-Za-z0-9./{}_-]{0,31}|\\{[A-Za-z][A-Za-z0-9_-]{0,29}\\})$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "sourceEventId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "sourceEventDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dimensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
