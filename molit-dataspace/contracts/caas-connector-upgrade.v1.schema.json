{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/caas-connector-upgrade.v1.json",
  "title": "CaaS connector upgrade request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "connectorPlanId"],
  "properties": {
    "schemaVersion": { "const": "molit.caas-connector-upgrade/1" },
    "connectorPlanId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    }
  }
}
