{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/detached-release-signature.v1.schema.json",
  "title": "MOLIT detached release signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "payload",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "molit.detached-release-signature/1"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileVersion",
        "artifactLockSha256",
        "manifestSha256",
        "signedAt",
        "signerKeyId"
      ],
      "properties": {
        "profileVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "artifactLockSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gitCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        },
        "signerKeyId": {
          "type": "string",
          "pattern": "^urn:molit:key:ed25519:sha256:[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
