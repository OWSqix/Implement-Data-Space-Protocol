{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/schema/network-reference-policy.v1.json",
  "title": "MOLIT network reference policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileVersion",
    "status",
    "identity",
    "elementIdentifiers",
    "coordinateOrder",
    "rdfProjection",
    "lifecycle",
    "sourceEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": "molit.network-reference-policy/1" },
    "profileVersion": { "const": "1.0.0-rc.1" },
    "status": { "const": "candidate-technical-evidence" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "checksumAlgorithm", "collisionRule", "checksumConflictRule", "crossEditionRule"],
      "properties": {
        "key": {
          "const": ["networkAuthority", "networkIdentifier", "networkVersion"]
        },
        "checksumAlgorithm": { "const": "sha-256" },
        "collisionRule": { "const": "same-key-requires-exactly-one-record" },
        "checksumConflictRule": { "const": "same-key-with-different-checksum-is-a-conflict" },
        "crossEditionRule": {
          "const": "same-authority-and-network-identifier-allows-distinct-version-and-checksum"
        }
      }
    },
    "elementIdentifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "link", "historyCode", "previousIdentifier"],
      "properties": {
        "node": { "$ref": "#/$defs/identifierRule" },
        "link": { "$ref": "#/$defs/identifierRule" },
        "historyCode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern", "sourceField"],
          "properties": {
            "pattern": { "const": "^(?:NODE|LINK)[0-9]{4}$" },
            "sourceField": { "const": "HIST_TYPE" }
          }
        },
        "previousIdentifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern", "sourceField", "meaning"],
          "properties": {
            "pattern": { "const": "^[0-9]{10}$" },
            "sourceField": { "const": "HISTREMARK" },
            "meaning": {
              "const": "source-provided-previous-element-identifier; not owl:sameAs"
            }
          }
        }
      }
    },
    "coordinateOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "rdf", "rule"],
      "properties": {
        "source": { "const": ["east-x", "north-y"] },
        "rdf": { "const": ["north", "east"] },
        "rule": {
          "const": "source tuple order is recorded separately and converted to the authority axis order of EPSG:5186 before RDF serialization"
        }
      }
    },
    "rdfProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceClass",
        "authorityProperty",
        "identifierProperty",
        "versionProperty",
        "checksumProperty",
        "lifecycleStatusProperty",
        "validFromProperty",
        "validUntilProperty",
        "replacementProperty",
        "lifecycleStatusNamespace"
      ],
      "properties": {
        "referenceClass": { "const": "https://data.molit.go.kr/def/molit-dcat-ap#NetworkReference" },
        "authorityProperty": { "const": "https://data.molit.go.kr/def/molit-dcat-ap#networkAuthority" },
        "identifierProperty": { "const": "https://data.molit.go.kr/def/molit-dcat-ap#networkIdentifier" },
        "versionProperty": { "const": "https://data.molit.go.kr/def/molit-dcat-ap#networkVersion" },
        "checksumProperty": { "const": "https://data.molit.go.kr/def/molit-dcat-ap#networkSnapshotChecksum" },
        "lifecycleStatusProperty": { "const": "https://data.molit.go.kr/def/molit-dcat-ap#networkLifecycleStatus" },
        "validFromProperty": { "const": "https://data.molit.go.kr/def/molit-dcat-ap#networkValidFrom" },
        "validUntilProperty": { "const": "https://data.molit.go.kr/def/molit-dcat-ap#networkValidUntil" },
        "replacementProperty": { "const": "http://purl.org/dc/terms/isReplacedBy" },
        "lifecycleStatusNamespace": { "const": "https://data.molit.go.kr/id/concept/network-lifecycle-status/" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "transitions", "transitionScope", "terminalStatuses", "replacementTargetStatuses", "replacementRule", "tombstoneRule"],
      "properties": {
        "statuses": {
          "const": ["candidate", "current", "superseded", "withdrawn"]
        },
        "transitions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "enum": ["candidate", "current"] },
              "to": { "enum": ["current", "superseded", "withdrawn"] }
            }
          }
        },
        "transitionScope": {
          "const": "allowed state changes of one edition; not a relation between predecessor and successor editions"
        },
        "terminalStatuses": { "const": ["superseded", "withdrawn"] },
        "replacementTargetStatuses": { "const": ["current", "superseded", "withdrawn"] },
        "replacementRule": {
          "const": "superseded requires exactly one in-graph successor; candidate, current and withdrawn prohibit a successor"
        },
        "tombstoneRule": {
          "const": "terminal edition identifiers remain resolvable with checksum, validity and replacement history"
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "archiveSha256", "reuseStatus", "observedElementTypes"],
      "properties": {
        "path": {
          "const": "examples/source-evidence/standard-node-link-2026-07-01.json"
        },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "reuseStatus": {
          "const": "institutional-redistribution-approval-pending"
        },
        "observedElementTypes": { "const": ["link", "node"] }
      }
    }
  },
  "$defs": {
    "identifierRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "sourceField", "evidenceStatus"],
      "properties": {
        "pattern": { "const": "^[0-9]{10}$" },
        "sourceField": { "enum": ["NODE_ID", "LINK_ID"] },
        "evidenceStatus": { "const": "observed-in-2026-07-01-source-sample" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
