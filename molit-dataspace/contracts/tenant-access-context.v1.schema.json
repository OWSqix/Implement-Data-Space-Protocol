{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.molit.go.kr/dataspace/contracts/tenant-access-context.v1.schema.json",
  "title": "MOLIT tenant access context",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "actorId", "actorKind", "accessMode", "traceId", "correlationId"],
  "properties": {
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "actorId": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$" },
    "actorKind": { "enum": ["user", "service", "workload", "operator"] },
    "accessMode": { "enum": ["tenant", "service", "break-glass"] },
    "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "correlationId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$" },
    "breakGlassReason": { "type": "string", "minLength": 8, "maxLength": 512 },
    "breakGlassExpiresAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "accessMode": { "const": "break-glass" } }, "required": ["accessMode"] },
      "then": { "required": ["breakGlassReason", "breakGlassExpiresAt"] },
      "else": {
        "properties": {
          "breakGlassReason": false,
          "breakGlassExpiresAt": false
        }
      }
    }
  ]
}
