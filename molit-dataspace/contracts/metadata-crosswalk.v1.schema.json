{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molit-dataspace.example.invalid/schemas/metadata-crosswalk.v1.schema.json",
  "title": "Metadata crosswalk with explicit loss and publication gates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mappingId",
    "status",
    "sourceProfile",
    "sourceVersion",
    "targetProfile",
    "authority",
    "sourceInventory",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "molit.metadata-crosswalk/1"
    },
    "mappingId": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "enum": ["working-draft", "approved", "retired"]
    },
    "sourceProfile": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "targetProfile": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "authority": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "sourceInventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 500
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\s]+$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourcePointerOrXPath",
        "sourceCardinality",
        "targetPath",
        "transform",
        "authority",
        "lossClass",
        "reverseRule",
        "publicationGate",
        "fixtureIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sourcePointerOrXPath": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "sourceCardinality": {
          "enum": ["0..1", "1..1", "0..n", "1..n"]
        },
        "targetPath": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "transform": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "authority": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "lossClass": {
          "enum": ["lossless", "normalized", "derived", "many-to-one", "not-published", "unmapped"]
        },
        "reverseRule": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "publicationGate": {
          "enum": ["automatic", "manual-review", "private-only", "reject"]
        },
        "fixtureIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
