{
  "name": "molit-dataspace-platform-bridge",
  "version": "0.1.0",
  "description": "Connector-neutral Platform Bridge for MOLIT dataspace integration",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "docs:style": "node tools/report-style/cli.mjs lint",
    "docs:style:strict": "node tools/report-style/cli.mjs lint --fail-on warning",
    "docs:style:json": "node tools/report-style/cli.mjs lint --format json",
    "docs:markdownlint": "markdownlint-cli2",
    "docs:profile": "node tools/report-style/cli.mjs profile",
    "docs:rules": "node tools/report-style/cli.mjs explain",
    "bridge:sync:baseline": "node src/cli.mjs sync --batch fixtures/discovery/baseline.json --state .local/discovery-state.json --config fixtures/discovery/config.json --approvals fixtures/discovery/approvals.json --report .local/baseline-report.json",
    "bridge:sync:delta": "node src/cli.mjs sync --batch fixtures/discovery/delta.json --state .local/discovery-state.json --config fixtures/discovery/config.json --approvals fixtures/discovery/approvals.json --report .local/delta-report.json",
    "bridge:review": "node src/cli.mjs review --state .local/discovery-state.json --config fixtures/discovery/config.json --approvals fixtures/discovery/approvals.json --report .local/review-assessment.json",
    "bridge:inspect": "node src/cli.mjs inspect --state .local/discovery-state.json",
    "bridge:runtime": "node src/bridge-runtime/cli.mjs --config fixtures/runtime/config.example.json",
    "bridge:runtime:once": "node src/bridge-runtime/cli.mjs --config fixtures/runtime/config.example.json --once",
    "bridge:runtime:dry-run": "node src/bridge-runtime/cli.mjs --config fixtures/runtime/config.example.json --dry-run",
    "bridge:dsp:smoke": "node src/bridge-runtime/dsp-smoke-cli.mjs",
    "transfer:worker": "node src/transfer-runtime/cli.mjs",
    "test:transfer-runtime": "node --test tests/unit/transfer-runtime-*.test.mjs tests/integration/provider-transfer-worker-e2e.test.mjs",
    "test:runtime": "node --test tests/unit/runtime-*.test.mjs tests/integration/runtime-worker-e2e.test.mjs",
    "namespace:serve": "node src/publication/cli.mjs",
    "namespace:attest": "node src/publication/attest-cli.mjs",
    "caas:serve": "node src/caas/cli.mjs --config fixtures/caas/config.example.json",
    "test:caas": "node --test tests/unit/caas-*.test.mjs tests/integration/caas-*.test.mjs",
    "dsaas:serve": "node src/dsaas/cli.mjs --config fixtures/dsaas/config.example.json",
    "test:dsaas": "node --test tests/unit/dsaas-*.test.mjs tests/integration/dsaas-*.test.mjs",
    "test:edc": "node --test tests/edc/*.test.mjs",
    "edc:verify": "node tools/edc/verify-topology.mjs",
    "edc:build": "node tools/edc/build-runtime.mjs",
    "edc:compose:verify": "node tools/edc/verify-compose.mjs",
    "edc:verify:runtime": "npm run edc:verify && npm run edc:build && npm run edc:compose:verify",
    "test:docs": "node --test tools/report-style/test/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:profile": "node --test tests/profile/*.test.mjs",
    "test:namespace": "node --test tests/namespace/*.test.mjs",
    "test:bridge": "npm run test:unit && npm run test:contract && npm run test:integration",
    "profile:list": "node src/profile/cli.mjs list",
    "profile:build": "node tools/profile/build-bundles.mjs",
    "profile:rc:build": "node tools/profile/build-bundles.mjs --version 1.0.0-rc.1",
    "profile:lock": "node tools/profile/update-artifact-lock.mjs",
    "profile:rc:lock": "node tools/profile/update-artifact-lock.mjs --version 1.0.0-rc.1",
    "profile:verify": "node src/profile/cli.mjs verify",
    "profile:requirements:evidence": "node tools/profile/build-requirement-evidence.mjs --write",
    "profile:requirements:verify": "node tools/profile/verify-requirement-traceability.mjs",
    "profile:requirements:upstream:build": "node tools/profile/build-upstream-requirement-inventory.mjs --write",
    "profile:requirements:upstream:verify": "node tools/profile/verify-upstream-requirement-inventory.mjs",
    "profile:requirements:upstream:engines": "node tools/profile/verify-upstream-requirement-inventory.mjs --engines",
    "profile:ontology:verify": "node tools/profile/verify-ontology-semantics.mjs",
    "profile:ontology:governance:verify": "node tools/profile/verify-ontology-term-governance.mjs",
    "profile:domestic-crosswalk:verify": "node tools/profile/verify-domestic-standards-crosswalk.mjs",
    "profile:network:verify": "node tools/profile/verify-network-reference-policy.mjs",
    "profile:publication:build": "node tools/profile/build-publication-representations.mjs --version 1.0.0-rc.1",
    "profile:publication:verify": "node tools/profile/build-publication-representations.mjs --version 1.0.0-rc.1 --check",
    "profile:vocabulary:build": "node tools/profile/build-vocabulary-registry.mjs --version 1.0.0-rc.1 --write",
    "profile:vocabulary:verify": "node tools/profile/build-vocabulary-registry.mjs --version 1.0.0-rc.1 --check",
    "profile:semantic-diff:build": "node tools/profile/build-semantic-diff.mjs --from 0.1.0 --to 1.0.0-rc.1 --write",
    "profile:semantic-diff:verify": "node tools/profile/build-semantic-diff.mjs --from 0.1.0 --to 1.0.0-rc.1 --check",
    "profile:rc:shacl-matrix": "node tools/profile/run-rc-shacl-matrix.mjs candidate --mode=representative",
    "profile:rc:shacl-matrix:full": "node tools/profile/run-rc-shacl-matrix.mjs candidate --mode=full",
    "profile:rc:shacl-matrix:verify": "node tools/profile/run-rc-shacl-matrix.mjs verify --mode=full",
    "profile:rc:serialization-parity": "node tools/profile/run-rc-serialization-parity.mjs candidate",
    "profile:rc:serialization-parity:verify": "node tools/profile/run-rc-serialization-parity.mjs verify",
    "profile:rc:verify": "node src/profile/cli.mjs verify --version 1.0.0-rc.1",
    "profile:verify:independent": "node tools/profile/run-independent-shacl.mjs",
    "profile:probe:jena": "node tools/profile/probe-jena.mjs",
    "profile:verify:jena": "node tools/profile/run-jena-shacl-gate.mjs verify",
    "toolchain:verify:jena": "node tools/dependencies/jena-toolchain.mjs verify",
    "dependencies:verify": "node tools/dependencies/node-install-evidence.mjs verify",
    "release:status": "node tools/release/release-gate.mjs",
    "release:status:rc": "node tools/release/release-gate.mjs --version 1.0.0-rc.1",
    "release:status:rc:candidate": "node tools/release/release-gate.mjs --version 1.0.0-rc.1 --target=candidate",
    "release:eol:verify": "node tools/release/verify-release-eol-policy.mjs",
    "registry:verify:iana": "node tools/registries/generate-iana-network-policy.mjs",
    "registry:verify:crs": "node tools/registries/verify-crs-snapshots.mjs",
    "profile:validate:example": "node src/profile/cli.mjs validate --input profiles/molit-dcat-ap/releases/0.1.0/examples/valid/road-network-catalog.ttl --profile geo-publication",
    "test": "npm run test:docs && npm run test:bridge && npm run test:profile && npm run test:namespace && npm run test:edc",
    "verify": "npm run docs:style:strict && npm run docs:markdownlint && npm run registry:verify:iana && npm run registry:verify:crs && npm run profile:requirements:verify && npm run profile:requirements:upstream:verify && npm run profile:ontology:governance:verify && npm run profile:domestic-crosswalk:verify && npm run profile:network:verify && npm run profile:publication:verify && npm run profile:vocabulary:verify && npm run profile:semantic-diff:verify && npm run edc:verify && npm test && npm run profile:ontology:verify && npm run profile:verify:independent",
    "verify:release:win32-x64": "npm run verify && npm run edc:verify:runtime && npm run dependencies:verify && npm run toolchain:verify:jena && npm run profile:verify:jena && npm run profile:requirements:upstream:engines && npm run profile:rc:serialization-parity:verify && npm run profile:rc:verify && npm run profile:rc:shacl-matrix:verify",
    "release:gate:win32-x64": "npm run verify:release:win32-x64 && npm run release:status:rc",
    "release:gate:win32-x64:candidate": "npm run verify:release:win32-x64 && npm run release:status:rc:candidate"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0",
    "jsonld": "9.0.0",
    "n3": "2.1.1",
    "proj4": "2.20.9",
    "rdf-canonize": "5.0.0",
    "rdf-validate-shacl": "0.6.5",
    "rdfxml-streaming-parser": "3.2.0",
    "undici": "6.27.0"
  },
  "devDependencies": {
    "entities": "4.5.0",
    "fontoxpath": "3.34.0",
    "markdown-it": "14.2.0",
    "markdownlint-cli2": "0.23.0",
    "parse5": "8.0.1",
    "saxes": "6.0.0",
    "slimdom-sax-parser": "1.5.3",
    "xmllint-wasm": "5.2.0"
  }
}
